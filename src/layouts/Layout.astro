---
// サイトURLの正は content_store.LINKS → src/data/links.json（ここでは読むだけ）
import links from '../data/links.json';
interface Props {
  title: string;
  description?: string;
  lang?: 'ja' | 'en';
}
const { title, description = '荻野舜樹の外部API — 生産活動から人間を排する。思想・作品・ブログ。', lang = 'ja' } = Astro.props;
const siteUrl = links.homepage.url;
const pageUrl = siteUrl + Astro.url.pathname;
const ogImage = siteUrl + '/og.png';
// hreflang: ja は素のパス、en は /en プレフィックス（相互に指す）。
const path = Astro.url.pathname;
const jaPath = path.replace(/^\/en(\/|$)/, '/');
const enPath = path.startsWith('/en') ? path : ('/en' + (path === '/' ? '' : path));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="ja" href={siteUrl + jaPath} />
    <link rel="alternate" hreflang="en" href={siteUrl + enPath} />
    <link rel="alternate" hreflang="x-default" href={siteUrl + jaPath} />
    <link rel="alternate" type="application/rss+xml" title="荻野舜樹のAI実験室 — Blog" href="/rss.xml" />
    <slot name="head" />
    <!-- OGP / SNSシェアカード -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="荻野舜樹のAI実験室" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      /* ── デザイントークン（色の唯一の正・SSoT）。配色変更はここ1箇所だけ ── */
      :root {
        --bg: #080c10;
        --bg-deep: #050810;
        --surface: #0f1923;
        --surface2: #0a0e14;
        --text: #e8edf2;
        --text2: #6b8096;
        --text3: #3d5266;
        --text-prose: #c2cdd6;
        --accent: #00d4ff;
        --accent-bright: #33ddff;
        --accent2: #3399ff;
        --border: #1a2d3d;
        --ok: #00d464;
        --warn: #ffb400;
        --danger: #ff4444;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        background-color: var(--bg);
        color: var(--text);
        font-family: 'Inter', system-ui, sans-serif;
        line-height: 1.6;
        overflow-x: hidden;
      }
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        background-image:
          linear-gradient(rgba(0, 212, 255, 0.025) 1px, transparent 1px),
          linear-gradient(90deg, rgba(0, 212, 255, 0.025) 1px, transparent 1px);
        background-size: 48px 48px;
        pointer-events: none;
        z-index: 0;
      }
      main { position: relative; z-index: 1; }
      ::selection { background: rgba(0, 212, 255, 0.2); color: var(--text); }
      ::-webkit-scrollbar { width: 4px; }
      ::-webkit-scrollbar-track { background: var(--bg); }
      ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }
    </style>
  </head>
  <body>
    <main>
      <slot />
    </main>
    <script>
      // 軽量PVビーコン: 開いた瞬間に path/referrer を1発送るだけ（IP・Cookieは送らない）。
      // sendBeacon は表示やページ遷移をブロックしない。失敗しても無視（計測はベストエフォート）。
      try {
        // src= は発信リンク(IG bio/YT概要欄)の経路刻印。トークンだけ送る（referrer欠落時も経路を確定できる）
        const src = new URLSearchParams(location.search).get('src') || '';
        const payload = JSON.stringify({ path: location.pathname, referrer: document.referrer,
                                         src: /^[a-z0-9_-]{1,24}$/.test(src) ? src : '' });
        if (navigator.sendBeacon) {
          navigator.sendBeacon('/api/pv', new Blob([payload], { type: 'application/json' }));
        } else {
          fetch('/api/pv', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload, keepalive: true }).catch(() => {});
        }
      } catch (e) { /* noop */ }
    </script>
  </body>
</html>
