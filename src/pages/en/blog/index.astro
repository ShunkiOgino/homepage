---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';
import thinking from '../../../data/thinking_en.json';

const posts = (await getCollection('blog-en', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const monthKey = (d) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;
const dayFmt = (d) =>
  `${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const months = [];
for (const p of posts) {
  const key = monthKey(p.data.date);
  const last = months[months.length - 1];
  if (last && last.key === key) last.posts.push(p);
  else months.push({ key, posts: [p] });
}

const themes = thinking.themes ?? [];
const weeks = thinking.weeks ?? [];
const gridCols = `minmax(210px,3.4fr) repeat(${weeks.length},minmax(14px,1fr)) 2.8rem`;
const cellBg = (c) =>
  c === 0 ? 'rgba(255,255,255,0.05)' : `rgba(0,212,255,${Math.min(0.22 + (c - 1) * 0.16, 0.95)})`;
---
<Layout title="Writing | Shunki Ogino's AI Lab" description="What Shunki Ogino is thinking about." lang="en">
  <Nav active="blog" lang="en" maxWidth="760px" />
  <section style="max-width:760px;margin:0 auto;padding:8rem 2rem 5rem;">
    <h1 style="font-size:2.3rem;font-weight:600;letter-spacing:-0.02em;margin-bottom:2.5rem;">Writing</h1>

    {themes.length > 0 && (
      <div style="margin-bottom:4.5rem;">
        <div style="font-family:'JetBrains Mono',monospace;font-size:0.75rem;color:var(--text3);letter-spacing:0.1em;margin-bottom:0.4rem;">THEMES I'M TRACKING</div>
        <div style="font-size:0.8rem;color:var(--text2);margin-bottom:1.2rem;">Cell intensity = observations logged that week. Open a row for articles.</div>
        <div class="week-head" style={`display:grid;grid-template-columns:${gridCols};gap:4px;align-items:center;padding:0 0 0.4rem;`}>
          <span></span>
          {weeks.map((w) => (
            <span style="font-family:'JetBrains Mono',monospace;font-size:0.6rem;color:var(--text3);text-align:center;">{w}</span>
          ))}
          <span style="font-family:'JetBrains Mono',monospace;font-size:0.6rem;color:var(--text3);text-align:center;">posts</span>
        </div>
        {themes.map((th) => (
          <details style="border-top:1px solid var(--border);">
            <summary class="theme-row" style={`display:grid;grid-template-columns:${gridCols};gap:4px;align-items:center;padding:0.55rem 0;cursor:pointer;`}>
              <span style="font-size:0.85rem;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;">{th.title}</span>
              {th.cells.map((c) => (
                <span style={`display:block;height:16px;border-radius:2px;background:${cellBg(c)};`}></span>
              ))}
              <span style="font-family:'JetBrains Mono',monospace;font-size:0.72rem;color:var(--accent);text-align:center;">{th.posts.length > 0 ? th.posts.length : ''}</span>
            </summary>
            <div style="padding:0.3rem 0.2rem 1.1rem;">
              {th.lead && (
                <p style="font-size:0.9rem;color:var(--text2);line-height:1.8;margin:0 0 0.7rem;max-width:640px;">{th.lead}</p>
              )}
              {th.posts.length > 0 ? (
                <div style="display:flex;flex-direction:column;gap:0.25rem;">
                  {th.posts.map((p) => (
                    <a href={`/en/blog/${p.slug}`} style="font-size:0.85rem;color:var(--accent);text-decoration:none;">
                      <span style="font-family:'JetBrains Mono',monospace;font-size:0.7rem;color:var(--text3);margin-right:0.6rem;">{p.date.slice(5).replace('-', '.')}</span>{p.title}
                    </a>
                  ))}
                </div>
              ) : (
                <span style="font-size:0.8rem;color:var(--text2);">No articles yet (tracking)</span>
              )}
            </div>
          </details>
        ))}
        <div style="font-family:'JetBrains Mono',monospace;font-size:0.75rem;color:var(--text3);letter-spacing:0.1em;margin-top:4.5rem;">LOG (DAILY NOTES)</div>
      </div>
    )}

    <div style="display:flex;flex-direction:column;gap:3rem;">
      {months.map((m) => (
        <section>
          <div style="display:flex;align-items:baseline;gap:0.8rem;border-bottom:1px solid var(--border);padding-bottom:0.6rem;margin-bottom:0.4rem;">
            <span style="font-family:'JetBrains Mono',monospace;font-size:0.95rem;font-weight:600;color:var(--text);letter-spacing:0.05em;">{m.key}</span>
            <span style="font-family:'JetBrains Mono',monospace;font-size:0.7rem;color:var(--text3);">{m.posts.length} posts</span>
          </div>
          {m.posts.map((p) => (
            <a href={`/en/blog/${p.slug}`} style="display:flex;align-items:baseline;gap:1rem;text-decoration:none;color:inherit;padding:0.55rem 0.3rem;">
              <span style="font-family:'JetBrains Mono',monospace;font-size:0.7rem;color:var(--text3);flex-shrink:0;">{dayFmt(p.data.date)}</span>
              <span style="font-size:1rem;font-weight:500;color:var(--text);line-height:1.5;">{p.data.title}</span>
            </a>
          ))}
        </section>
      ))}
    </div>
  </section>
  <Footer lang="en" />
</Layout>

<style>
  summary.theme-row {
    list-style: none;
  }
  summary.theme-row::-webkit-details-marker {
    display: none;
  }
  summary.theme-row:hover {
    background: rgba(0, 212, 255, 0.03);
  }
  @media (max-width: 640px) {
    .week-head {
      display: none !important;
    }
  }
</style>
