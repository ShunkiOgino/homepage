---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import meaningLinks from '../../data/meaning_links.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
// キャリア記事の末尾だけ、就活イベント(/experiment)への導線を出す（記事→受け皿の逆流を塞ぐ）。
const isCareer = post.data.tags?.includes('キャリア');
// 近いところ＝意味の繋がり（時系列でもタグでもない・E層）。作品も混在。
const near = (meaningLinks[`blog:${post.slug}`]?.near) || [];
const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

import links from '../../data/links.json';
const siteUrl = links.homepage.url;
const articleJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description || '',
  "datePublished": post.data.date.toISOString(),
  "dateModified": post.data.date.toISOString(),
  "url": `${siteUrl}/blog/${post.slug}`,
  "author": {
    "@type": "Person",
    "name": "荻野舜樹",
    "url": siteUrl
  },
  "publisher": {
    "@type": "Person",
    "name": "荻野舜樹",
    "url": siteUrl
  },
  "keywords": post.data.tags?.join(', ') || '',
  "inLanguage": "ja"
});
---
<Layout title={`${post.data.title} | 荻野舜樹のAI実験室`} description={post.data.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={articleJsonLd} />
  </Fragment>
  <Nav active="blog" maxWidth="760px" />

  <article style="max-width:760px;margin:0 auto;padding:8rem 2rem 6rem;">
    <a href="/blog" style="font-family:'JetBrains Mono',monospace;font-size:0.72rem;color:var(--text2);text-decoration:none;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text2)'">← blog</a>
    <div style="font-family:'JetBrains Mono',monospace;font-size:0.72rem;color:var(--text2);letter-spacing:0.05em;margin-top:1.5rem;">{fmt(post.data.date)}</div>
    <h1 style="font-size:2rem;font-weight:600;line-height:1.3;margin:0.5rem 0 0.8rem;letter-spacing:-0.01em;">{post.data.title}</h1>
    {post.data.tags.length > 0 && (
      <div style="display:flex;gap:0.5rem;margin-bottom:2.5rem;flex-wrap:wrap;">
        {post.data.tags.map((t) => (
          <span style="font-size:0.65rem;font-family:'JetBrains Mono',monospace;color:var(--accent);border:1px solid rgba(0,212,255,0.2);background:rgba(0,212,255,0.06);padding:0.15rem 0.5rem;">{t}</span>
        ))}
      </div>
    )}
    <div class="prose">
      <Content />
    </div>

    {isCareer && (
      <aside class="cta-exp-box">
        <div class="cta-exp-eyebrow">人生ありきの、就活イベント</div>
        <p class="cta-exp-lead">こんな話をする集まりを、やりたいと思っています。会社に合わせる前に、自分の人生を先に見る。答えは教えません。この話を物差しに、自分の記録を読む——それだけです。</p>
        <p class="cta-exp-sub">日程と場所は、集まってから。興味だけでOK。</p>
        <a class="cta-exp-link" href="/experiment?src=blog">来たい人はこちら →</a>
      </aside>
    )}

    {near.length > 0 && (
      <div style="margin-top:3.5rem;padding-top:1.5rem;border-top:1px solid var(--border);">
        <span style="font-family:'JetBrains Mono',monospace;font-size:0.68rem;color:var(--text3);letter-spacing:0.06em;">近いところ <span style="color:var(--text3);opacity:0.7;">— 意味でつながる考えと作品</span></span>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;margin-top:1rem;">
          {near.map((r) => (
            <a href={r.url} class="pn">
              <div class="pn-l">{r.type === '作品' ? '作ったもの' : '考えていること'}</div>
              <div class="pn-n">{r.title}</div>
              <div class="pn-e">{r.why}</div>
            </a>
          ))}
        </div>
      </div>
    )}
  </article>

  <Footer />

  <style is:global>
    .prose { color: var(--text-prose); font-size: 1.02rem; line-height: 1.85; }
    .prose h2 { color: var(--text); font-size: 1.4rem; font-weight: 600; margin: 2.5rem 0 1rem; letter-spacing: -0.01em; }
    .prose h3 { color: var(--text); font-size: 1.15rem; font-weight: 600; margin: 2rem 0 0.8rem; }
    .prose p { margin: 1.1rem 0; }
    .prose strong { color: var(--text); font-weight: 600; }
    .prose a { color: var(--accent); text-decoration: none; border-bottom: 1px solid rgba(0,212,255,0.3); }
    .prose a:hover { border-bottom-color: var(--accent); }
    .prose ul, .prose ol { margin: 1.1rem 0; padding-left: 1.4rem; }
    .prose li { margin: 0.4rem 0; }
    .prose blockquote { border-left: 2px solid var(--accent); margin: 1.4rem 0; padding: 0.3rem 0 0.3rem 1.2rem; color: var(--text2); }
    .prose code { font-family: 'JetBrains Mono', monospace; font-size: 0.88em; background: rgba(0,212,255,0.08); color: var(--accent); padding: 0.1rem 0.4rem; border-radius: 3px; }
    .prose pre { background: var(--surface2); border: 1px solid var(--border); border-radius: 6px; padding: 1rem 1.2rem; overflow-x: auto; margin: 1.4rem 0; }
    .prose pre code { background: none; color: var(--text-prose); padding: 0; }
    .prose img { max-width: 100%; border-radius: 6px; margin: 1.4rem 0; }
    .prose hr { border: none; border-top: 1px solid var(--border); margin: 2.5rem 0; }
    .pn { display: block; border: 1px solid var(--border); padding: 1rem 1.2rem; text-decoration: none; transition: border-color .15s, background .15s; }
    .pn:hover { border-color: var(--accent); background: var(--surface); }
    .pn-l { font-family: 'JetBrains Mono', monospace; font-size: 0.66rem; color: var(--text3); letter-spacing: 0.05em; }
    .pn-n { font-size: 1rem; font-weight: 500; color: var(--text); margin: 0.4rem 0 0.3rem; }
    .pn-e { font-size: 0.78rem; color: var(--text2); font-family: 'JetBrains Mono', monospace; }
    .pn.empty { opacity: 0.45; }
    .cta-exp-box { margin-top: 3.5rem; border: 1px solid rgba(0,212,255,0.35); background: rgba(0,212,255,0.05); padding: 1.6rem 1.7rem; }
    .cta-exp-eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 0.66rem; color: var(--accent); letter-spacing: 0.08em; margin-bottom: 0.7rem; }
    .cta-exp-lead { margin: 0 0 0.5rem; font-size: 1.02rem; color: var(--text); line-height: 1.75; }
    .cta-exp-sub { margin: 0 0 1.2rem; font-size: 0.88rem; color: var(--text2); line-height: 1.7; }
    .cta-exp-link { display: inline-block; font-size: 0.9rem; color: var(--accent); text-decoration: none; border: 1px solid rgba(0,212,255,0.4); padding: 0.5rem 1rem; letter-spacing: 0.03em; transition: border-color .15s, background .15s; }
    .cta-exp-link:hover { border-color: var(--accent); background: rgba(0,212,255,0.1); }
    @media (max-width: 600px) {
      nav[style*="grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr !important; }
      nav[style*="grid-template-columns:1fr 1fr"] .pn[style*="right"] { text-align: left !important; }
    }
    @media (max-width: 640px) {
      article { padding-left: 1.25rem !important; padding-right: 1.25rem !important; }
    }
  </style>
</Layout>
