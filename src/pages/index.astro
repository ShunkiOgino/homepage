---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import latest from '../data/latest_posts.json';
import links from '../data/links.json';
import { getCollection } from 'astro:content';

// 考えていること＝ブログ＝一本の流れ（log）。トップ冒頭に最新の一本を置く。
const _posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latestPost = _posts[0] || null;
const fmtD = (d) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

// 作ったもの — 考えていることの「証拠」。どれも自分のための道具。
const works = [
  {
    title: '散逸構造ゲーム',
    sub: 'ゲーム / 物理',
    desc: '物理の法則をそのままルールに組み込んだゲーム。むずかしい考えを、説明ではなく「触って分かる」形に置き換える実験です。',
    tags: ['ゲーム', 'ブラウザで遊べる'],
    href: '/game/',
    cta: '遊んでみる →',
    repo: 'https://github.com/ShunkiOgino/dissipation-game/archive/refs/heads/main.zip',
    status: '公開中',
  },
  {
    title: '自動でメールに返事するAI',
    sub: 'AIエージェント',
    desc: '送ってきた相手ごとに専用のAIが立ち上がり、私のパソコンの中で動くAI（Gemma4）が内容を整理して返事をします。メールの中身は外部のAIに渡さず手元で処理し、相手ごとに見られる範囲を分け、別の人のやり取りには触れられない作りです。',
    tags: ['AI', 'メール自動化', 'ローカル処理'],
    href: '/works/agent-mail',
    cta: '中を見る →',
    repo: 'https://github.com/ShunkiOgino/agent-mail-demo/archive/refs/heads/main.zip',
    status: '稼働中',
  },
  {
    title: '動画を作るスタジオ',
    sub: '動画制作ツール',
    desc: '話した内容からAIが台本を起こし、キャラクターの配置・音声合成・書き出しまでを自動で。動画を作る手間を、丸ごと機械に渡す試みです。台本づくりも音声もぜんぶローカルで動きます。',
    tags: ['動画', 'AI台本', '音声合成'],
    href: '/works/video-studio',
    cta: '中を見る →',
    repo: 'https://github.com/ShunkiOgino/video-studio-demo/archive/refs/heads/main.zip',
    status: '稼働中',
  },
  {
    title: '漫画を作るツール',
    sub: '漫画 / 制作ツール',
    desc: '漫画を作るための道具そのものを自分で組んでいます。ページにコマを割り、棚からポーズや背景を置き、手元で動くAIがページの絵を見て見せ方を一緒に考える。市販のソフトに預けず、AIをループに入れて作れる自作のエディタです。読切を一本、これで制作中。',
    tags: ['漫画', '自作ツール', 'ローカルAI'],
    href: '/works/manga',
    cta: 'ツールをさわってみる →',
    status: '制作中',
  },
];
---
<Layout
  title="荻野舜樹のAI実験室 — めんどうは機械に、人は好きなことを"
  description="めんどうなことは機械にやらせて、人は好きなことに時間を使えるように。荻野舜樹が考えていること、作ったもの。"
>
  <Nav />

  <!-- Hero（やわらかい一文を主役に） -->
  <section style="min-height:100vh;display:flex;align-items:center;padding:0 2rem;padding-top:56px;">
    <div style="max-width:1100px;margin:0 auto;width:100%;">
      <h1 style="font-size:clamp(2rem,5vw,3.8rem);font-weight:700;line-height:1.3;letter-spacing:-0.02em;margin-bottom:1.75rem;color:var(--text);">
        めんどうなことは、<span style="color:var(--accent);">機械にやらせる。</span><br />人は、好きなことに時間を使えばいい。
      </h1>
      <p style="font-size:1.05rem;color:var(--text-prose);max-width:600px;margin-bottom:1rem;line-height:1.9;">
        そういう道具を、まず自分のために作っています。いつか、みんなのぶんも。
      </p>
      <p style="font-size:0.95rem;color:var(--text2);max-width:600px;margin-bottom:2.5rem;line-height:1.9;">
        このサイトは、私が何を考えて、何を作っているのかを置いておく場所です。
      </p>

      <!-- 入口カード（メタファなし・一般語） -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1.5px;background:var(--border);margin-top:3rem;border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
        {[
          ['作ったもの', '自分のために作った道具', '#works', ''],
          ['ブログ', '考えていること・日々の記録', '/blog', ''],
          ['連絡', 'AIがまず返事をします', '#contact', ''],
          ['Discord', 'ローカルエージェントAIの実験室', links.discord.url, '仲間募集中！'],
        ].map(([label, desc, href, badge]) => (
          <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener noreferrer' : undefined} style="background:var(--bg);padding:1.25rem 1.5rem;text-decoration:none;display:block;" onmouseover="this.style.background='var(--surface)'" onmouseout="this.style.background='var(--bg)'">
            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.35rem;flex-wrap:wrap;">
              <span style="font-size:1rem;color:var(--text);font-weight:600;">{label}</span>
              {badge && <span style="font-size:0.62rem;background:rgba(0,212,255,0.12);color:var(--accent);border:1px solid rgba(0,212,255,0.25);padding:0.1rem 0.45rem;border-radius:2px;font-weight:600;">{badge}</span>}
            </div>
            <div style="font-size:0.8rem;color:var(--text2);line-height:1.6;">{desc}</div>
          </a>
        ))}
      </div>
      <p style="font-size:0.85rem;color:var(--text3);margin-top:2rem;">荻野舜樹のAI実験室</p>
    </div>
  </section>

  <!-- 最新の発信（log層の流入口：直近のYouTube/Instagram） -->
  <section id="latest" style="padding:5rem 2rem;border-top:1px solid var(--border);scroll-margin-top:56px;">
    <div style="max-width:1100px;margin:0 auto;">
      <div style="margin-bottom:2rem;max-width:720px;">
        <h2 style="font-size:2rem;font-weight:600;letter-spacing:-0.02em;">最新の発信</h2>
        <p style="color:var(--text2);margin-top:0.6rem;line-height:1.8;">考えていること（ブログ）と、YouTube・Instagram の直近です。日々の記録が、一本の流れになってここに集まります。</p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.25rem;align-items:start;">
        {_posts.slice(0, 2).map((p) => (
          <a href={`/blog/${p.slug}`} style="text-decoration:none;color:inherit;display:block;border:1px solid var(--border);background:var(--surface);overflow:hidden;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
            <div style="aspect-ratio:16/9;background:var(--surface2);display:flex;flex-direction:column;justify-content:center;padding:1.1rem 1.2rem;border-bottom:1px solid var(--border);">
              <span style="font-family:'JetBrains Mono',monospace;font-size:0.6rem;letter-spacing:0.05em;color:var(--accent);">考えていること</span>
              <div style="font-size:1.05rem;font-weight:600;line-height:1.4;color:var(--text);margin-top:0.5rem;">{p.data.title}</div>
            </div>
            <div style="padding:0.85rem 0.95rem;">
              {p.data.description && <div style="font-size:0.8rem;line-height:1.55;color:var(--text2);">{p.data.description}</div>}
              <div style="font-size:0.68rem;color:var(--text3);margin-top:0.5rem;font-family:'JetBrains Mono',monospace;">{fmtD(p.data.date)}</div>
            </div>
          </a>
        ))}
        {latest.youtube.map((v) => (
          <a href={v.url} target="_blank" rel="noopener noreferrer" style="text-decoration:none;color:inherit;display:block;border:1px solid var(--border);background:var(--surface);overflow:hidden;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
            <div style="position:relative;aspect-ratio:16/9;background:#000;">
              <img src={v.thumb} alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;" />
              <span style="position:absolute;bottom:0.5rem;left:0.5rem;background:rgba(0,0,0,0.72);color:#fff;font-size:0.6rem;letter-spacing:0.05em;padding:0.2rem 0.5rem;">▶ YouTube</span>
            </div>
            <div style="padding:0.85rem 0.95rem;">
              <div style="font-size:0.82rem;line-height:1.55;color:var(--text);">{v.title}</div>
              {v.date && <div style="font-size:0.68rem;color:var(--text3);margin-top:0.5rem;font-family:'JetBrains Mono',monospace;">{v.date}</div>}
            </div>
          </a>
        ))}
        {latest.instagram.map((p) => (
          <a href={p.permalink} target="_blank" rel="noopener noreferrer" style="text-decoration:none;color:inherit;display:block;border:1px solid var(--border);background:var(--surface);overflow:hidden;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
            <div style="position:relative;aspect-ratio:16/9;background:#000;display:flex;align-items:center;justify-content:center;">
              {p.thumb ? (
                <img src={p.thumb} alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;" />
              ) : (
                <span style="color:var(--text3);font-size:0.7rem;">Instagram</span>
              )}
              <span style="position:absolute;bottom:0.5rem;left:0.5rem;background:rgba(0,0,0,0.72);color:#fff;font-size:0.6rem;letter-spacing:0.05em;padding:0.2rem 0.5rem;">Instagram</span>
            </div>
            <div style="padding:0.85rem 0.95rem;">
              {p.caption && <div style="font-size:0.8rem;line-height:1.55;color:var(--text2);">{p.caption}</div>}
              {p.date && <div style="font-size:0.68rem;color:var(--text3);margin-top:0.5rem;font-family:'JetBrains Mono',monospace;">{p.date}</div>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 作ったもの -->
  <section id="works" style="padding:6rem 2rem;border-top:1px solid var(--border);scroll-margin-top:56px;">
    <div style="max-width:1100px;margin:0 auto;">
      <div style="margin-bottom:3rem;max-width:720px;">
        <h2 style="font-size:2.3rem;font-weight:600;letter-spacing:-0.02em;">作ったもの</h2>
        <p style="color:var(--text2);margin-top:0.75rem;line-height:1.9;">考えていることの、証拠みたいなものです。どれも自分のために作った道具で、私の手を離れても動くように作っています。</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.5px;background:var(--border);">
        {works.map((w) => (
          <div style="background:var(--bg);padding:2rem;position:relative;overflow:hidden;display:flex;flex-direction:column;" onmouseover="this.style.background='var(--surface)'" onmouseout="this.style.background='var(--bg)'">
            <div style="position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(to right,var(--accent),transparent);"></div>
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1rem;">
              <span style="font-size:0.72rem;color:var(--text2);">{w.sub}</span>
              <span style="font-size:0.65rem;background:rgba(0,212,255,0.1);color:var(--accent);padding:0.2rem 0.6rem;border:1px solid rgba(0,212,255,0.2);">{w.status}</span>
            </div>
            <h3 style="font-size:1.3rem;font-weight:600;margin-bottom:0.75rem;letter-spacing:-0.01em;">{w.title}</h3>
            <p style="font-size:0.875rem;color:var(--text2);line-height:1.8;margin-bottom:1.5rem;flex:1;">{w.desc}</p>
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1.5rem;">
              {w.tags.map(t => (
                <span style="font-size:0.7rem;color:var(--text3);border:1px solid var(--border);padding:0.2rem 0.6rem;">{t}</span>
              ))}
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;gap:0.5rem;">
              <span>
                {w.repo && (
                  <a href={w.repo} style="font-size:0.78rem;color:var(--text2);text-decoration:none;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text2)'">ソースをダウンロード (MIT) ↓</a>
                )}
              </span>
              {w.href ? (
                <a href={w.href} style="font-size:0.85rem;color:var(--accent);text-decoration:none;" onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'">{w.cta}</a>
              ) : (
                <span style="font-size:0.85rem;color:var(--text3);">{w.cta}</span>
              )}
            </div>
          </div>
        ))}
      </div>
      <p style="color:var(--text2);margin-top:2rem;font-size:0.9rem;line-height:1.9;max-width:720px;">
        買って使える「製品」は準備中です。最初の一本は、人とのつながりを助ける道具になる予定です。
      </p>
    </div>
  </section>

  <!-- 連絡（自動返信AIの実演） -->
  <section id="contact" style="padding:6rem 2rem;border-top:1px solid var(--border);scroll-margin-top:56px;">
    <div style="max-width:640px;margin:0 auto;">
      <div style="margin-bottom:3rem;">
        <h2 style="font-size:2.3rem;font-weight:600;letter-spacing:-0.02em;">連絡</h2>
        <p style="color:var(--text2);margin-top:0.75rem;line-height:1.9;">
          ここから送ると、私のパソコンの中で動くAIが内容を整理して、まず自動でお返事します。実はこれ自体が、上で紹介している<span style="color:var(--text);">「自動でメールに返事するAI」を実際に動かして見せているもの</span>です。一緒に作りたい人、応援したい人、見学したい人、どなたでもどうぞ。
        </p>
        <div style="background:var(--surface);border:1px solid var(--border);padding:1.25rem 1.5rem;margin-top:1.25rem;">
          <div style="font-size:0.78rem;color:var(--text2);margin-bottom:1rem;font-weight:600;">送信してから返事が届くまで</div>
          <div style="display:flex;gap:0;flex-wrap:wrap;">
            {[
              ['1', 'フォームを送信', 'サーバーに保存'],
              ['2', 'AIが受け取る', '内容を整理'],
              ['3', '自動で返信', 'メールでお返事'],
              ['4', '本人が確認', '荻野が読んで動く'],
            ].map(([n, t, d]) => (
              <div style="flex:1;min-width:120px;padding:0.5rem 0.75rem;border-left:1px solid var(--border);">
                <div style="font-size:0.85rem;color:var(--accent);margin-bottom:0.3rem;font-weight:600;">{n}</div>
                <div style="font-size:0.8rem;font-weight:500;margin-bottom:0.15rem;">{t}</div>
                <div style="font-size:0.7rem;color:var(--text2);">{d}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
      <form id="contact-form" style="display:flex;flex-direction:column;gap:1.5rem;">
        <div class="form-2col" style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
          <div>
            <label style="font-size:0.8rem;color:var(--text2);display:block;margin-bottom:0.5rem;">お名前 <span style="color:var(--accent);">*</span></label>
            <input id="f-name" type="text" required placeholder="お名前" style="width:100%;background:var(--surface);border:1px solid var(--border);color:var(--text);padding:0.7rem 1rem;font-size:0.875rem;outline:none;font-family:inherit;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'" />
          </div>
          <div>
            <label style="font-size:0.8rem;color:var(--text2);display:block;margin-bottom:0.5rem;">所属（任意）</label>
            <input id="f-company" type="text" placeholder="会社・チームなど" style="width:100%;background:var(--surface);border:1px solid var(--border);color:var(--text);padding:0.7rem 1rem;font-size:0.875rem;outline:none;font-family:inherit;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'" />
          </div>
        </div>
        <div>
          <label style="font-size:0.8rem;color:var(--text2);display:block;margin-bottom:0.5rem;">メールアドレス <span style="color:var(--accent);">*</span></label>
          <input id="f-email" type="email" required placeholder="you@example.com" style="width:100%;background:var(--surface);border:1px solid var(--border);color:var(--text);padding:0.7rem 1rem;font-size:0.875rem;outline:none;font-family:inherit;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'" />
        </div>
        <div>
          <label style="font-size:0.8rem;color:var(--text2);display:block;margin-bottom:0.5rem;">どんな用件ですか？ <span style="color:var(--accent);">*</span></label>
          <input id="f-system" type="text" required placeholder="例：一緒に作りたい / 考えに共感した / 見学したい / その他" style="width:100%;background:var(--surface);border:1px solid var(--border);color:var(--text);padding:0.7rem 1rem;font-size:0.875rem;outline:none;font-family:inherit;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'" />
        </div>
        <div>
          <label style="font-size:0.8rem;color:var(--text2);display:block;margin-bottom:0.5rem;">いま考えていること <span style="color:var(--accent);">*</span></label>
          <textarea id="f-situation" required rows="3" placeholder="どんなきっかけで、ここに辿り着きましたか" style="width:100%;background:var(--surface);border:1px solid var(--border);color:var(--text);padding:0.7rem 1rem;font-size:0.875rem;outline:none;font-family:inherit;resize:vertical;line-height:1.6;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'"></textarea>
        </div>
        <div>
          <label style="font-size:0.8rem;color:var(--text2);display:block;margin-bottom:0.5rem;">こうなったらいいな（目標） <span style="color:var(--accent);">*</span></label>
          <textarea id="f-outcome" required rows="3" placeholder="一緒に向かいたい先や、実現したいこと" style="width:100%;background:var(--surface);border:1px solid var(--border);color:var(--text);padding:0.7rem 1rem;font-size:0.875rem;outline:none;font-family:inherit;resize:vertical;line-height:1.6;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'"></textarea>
        </div>
        <div>
          <label style="font-size:0.8rem;color:var(--text2);display:block;margin-bottom:0.5rem;">時期感・規模（任意）</label>
          <input id="f-timeline" type="text" placeholder="例：急ぎではない、まずは話してみたい" style="width:100%;background:var(--surface);border:1px solid var(--border);color:var(--text);padding:0.7rem 1rem;font-size:0.875rem;outline:none;font-family:inherit;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'" />
        </div>
        <!-- ボット対策: honeypot（人間には見えない。埋まっていたらボット） -->
        <input id="f-website" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" />
        <div id="form-result" style="display:none;"></div>
        <button type="submit" id="submit-btn" style="background:var(--accent);color:var(--bg);padding:0.875rem 2rem;font-weight:600;font-size:0.9rem;border:none;cursor:pointer;letter-spacing:0.03em;align-self:flex-start;" onmouseover="this.style.background='var(--accent-bright)'" onmouseout="this.style.background='var(--accent)'">送信する</button>
      </form>
    </div>
  </section>

  <script>
    // フォーム表示時刻（あまりに即答な送信＝ボットを弾く判定用）
    const _formLoadedAt = Date.now();
    document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('submit-btn') as HTMLButtonElement;
      const result = document.getElementById('form-result') as HTMLElement;
      btn.textContent = '送信中...';
      btn.disabled = true;

      const payload = {
        name: (document.getElementById('f-name') as HTMLInputElement).value,
        company: (document.getElementById('f-company') as HTMLInputElement).value,
        email: (document.getElementById('f-email') as HTMLInputElement).value,
        system_type: (document.getElementById('f-system') as HTMLInputElement).value,
        current_situation: (document.getElementById('f-situation') as HTMLTextAreaElement).value,
        desired_outcome: (document.getElementById('f-outcome') as HTMLTextAreaElement).value,
        timeline: (document.getElementById('f-timeline') as HTMLInputElement).value,
        website: (document.getElementById('f-website') as HTMLInputElement).value, // honeypot
        elapsed_ms: Date.now() - _formLoadedAt,                                    // 送信までの時間
      };

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          result.style.display = 'block';
          result.style.color = 'var(--ok)';
          result.style.fontSize = '0.875rem';
          result.textContent = '送信しました。AIが内容を整理次第、入力いただいたメアドに折り返します（通常数時間以内）。';
          (document.getElementById('contact-form') as HTMLFormElement).reset();
        } else {
          throw new Error();
        }
      } catch {
        result.style.display = 'block';
        result.style.color = 'var(--danger)';
        result.style.fontSize = '0.875rem';
        result.textContent = '送信に失敗しました。時間をおいて再度お試しください。';
      } finally {
        btn.textContent = '送信する';
        btn.disabled = false;
      }
    });
  </script>

  <Footer />

  <style>
    /* スマホ対応 */
    @media (max-width: 600px) {
      .form-2col { grid-template-columns: 1fr !important; }
      section { padding-left: 1.25rem !important; padding-right: 1.25rem !important; }
    }
  </style>
</Layout>
