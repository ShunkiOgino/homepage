};

window.scrollToSection = function(sectionId, navId) {
  document.querySelectorAll('.nav-item').forEach(function(el) { el.classList.remove('active'); });
  var nav = document.getElementById(navId);
  if (nav) nav.classList.add('active');
  var sec = document.getElementById(sectionId);
  if (sec) sec.scrollIntoView({ behavior: 'smooth' });
};

// ---- scripts ----
window.selectScript = function(idx) {
  selectedScript = idx;
  var rows = document.querySelectorAll('.script-row');
  rows.forEach(function(r, i) {
    r.classList.toggle('selected', i === idx);
  });
  var s = SCRIPTS[idx];
  var detail = document.getElementById('script-detail');
  detail.classList.add('open');
  document.getElementById('detail-title').textContent = s.title;

  // chips
  var chips = s.sections.map(function(sec) {
    return '<span class="chip">' + sec + '</span>';
  }).join('');
  document.getElementById('detail-chips').innerHTML = chips;

  // ratio bar
  var kPct = s.koharuPct;
  var hPct = 100 - kPct;
  document.getElementById('detail-koharu-bar').style.width = kPct + '%';
  document.getElementById('detail-haruto-bar').style.width = hPct + '%';
  document.getElementById('detail-koharu-pct').textContent = kPct + '%';
  document.getElementById('detail-haruto-pct').textContent = hPct + '%';

  // preview
  document.getElementById('detail-preview').textContent = s.preview;
};

window.closeDetail = function() {
  document.getElementById('script-detail').classList.remove('open');
  document.querySelectorAll('.script-row').forEach(function(r) { r.classList.remove('selected'); });
  selectedScript = -1;
};

// ---- visual settings ----
window.setStyle = function(style) {
  document.getElementById('style-interview').classList.toggle('active', style === 'interview');
  document.getElementById('style-variety').classList.toggle('active', style === 'variety');
};

window.updatePreview = function() {
  var size = parseInt(document.getElementById('sl-size').value);
  var lx = parseInt(document.getElementById('sl-lx').value);
  var rx = parseInt(document.getElementById('sl-rx').value);
  var y = parseInt(document.getElementById('sl-y').value);

  document.getElementById('lbl-size').textContent = size;
  document.getElementById('lbl-lx').textContent = lx;
  document.getElementById('lbl-rx').textContent = rx;
  document.getElementById('lbl-y').textContent = y;

  // map to preview 480x270 scale (original canvas: 1920x1080)
  var scaleX = 480 / 1920;
  var scaleY = 270 / 1080;
  var pxSize = size * scaleX;
  var pxLx = lx * scaleX;
  var pxRx = rx * scaleX;
  var pxY = y * scaleY;

  var leftEl = document.getElementById('prev-left');
  var rightEl = document.getElementById('prev-right');

  // bottom = preview height - pxY
  var boxH = 270;
  var bottomOffset = boxH - pxY;

  leftEl.style.width = pxSize + 'px';
  leftEl.style.height = pxSize + 'px';
  leftEl.style.left = pxLx + 'px';
  leftEl.style.bottom = (bottomOffset - pxSize / 2) + 'px';
  leftEl.style.top = 'auto';

  rightEl.style.width = pxSize + 'px';
  rightEl.style.height = pxSize + 'px';
  rightEl.style.left = pxRx + 'px';
  rightEl.style.bottom = (bottomOffset - pxSize / 2) + 'px';
  rightEl.style.top = 'auto';
};

window.saveSettings = function() {
