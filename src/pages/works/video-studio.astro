// 実際の video_maker.py と同じ座標系（1920×1080キャンバス・既定 左X290/右X990/下端Y618/サイズ360）で
// 本物の Live2D（こはる左＝聞き手／はると右＝話し手）をプレビューに配置する。
var L2D = { app: null, koharu: null, haruto: null };

function placeOne(model, cx) {
  if (!model || !L2D.app) return;
  var pw = L2D.app.renderer.width, ph = L2D.app.renderer.height;
  var sx = pw / 1920, sy = ph / 1080;
  var size = parseInt(document.getElementById('sl-size').value);
  var y = parseInt(document.getElementById('sl-y').value);
  var targetH = size * sy;                 // プレビュー上のキャラ高さ
  model.scale.set(targetH / model.__baseH);
  model.x = cx * sx;
  model.y = y * sy;                        // anchor(0.5,1) なので足元の高さ
}

window.updatePreview = function() {
  var size = parseInt(document.getElementById('sl-size').value);
  var lx = parseInt(document.getElementById('sl-lx').value);
  var rx = parseInt(document.getElementById('sl-rx').value);
  var y = parseInt(document.getElementById('sl-y').value);

  document.getElementById('lbl-size').textContent = size;
  document.getElementById('lbl-lx').textContent = lx;
  document.getElementById('lbl-rx').textContent = rx;
  document.getElementById('lbl-y').textContent = y;

  placeOne(L2D.koharu, lx);   // こはる＝左
  placeOne(L2D.haruto, rx);   // はると＝右
};

function initLive2D() {
  var canvas = document.getElementById('live2d-preview');
  if (!canvas || !window.PIXI || !window.PIXI.live2d) return;
  var stage = document.getElementById('preview-stage');
  L2D.app = new PIXI.Application({
    view: canvas, autoStart: true, backgroundAlpha: 0, antialias: true,
    resolution: window.devicePixelRatio || 1, autoDensity: true, resizeTo: stage,
  });
  var loadingEl = document.getElementById('live2d-loading');
  var pending = 2;
  function done() { if (--pending <= 0 && loadingEl) loadingEl.style.display = 'none'; }
  function add(url, key, anchorBottom) {
    PIXI.live2d.Live2DModel.from(url).then(function(model) {
      model.anchor.set(0.5, 1);
      model.__baseH = model.height;   // scale=1 のときの実寸
      L2D.app.stage.addChild(model);
      L2D[key] = model;
      window.updatePreview();
      done();
    }).catch(function(e) { console.warn('Live2D load failed:', url, e); done(); });
  }
  add('/live2d/koharu/koharu.model3.json', 'koharu');
  add('/live2d/haruto/haruto.model3.json', 'haruto');
  window.addEventListener('resize', function(){ window.updatePreview(); });
}

window.saveSettings = function() {
  toast('設定を保存しました（デモ: ブラウザのみ）');
};

// ---- init preview ----
(function() {
  initLive2D();   // Live2D を読み込み、ロード完了時に updatePreview が呼ばれる
  updatePreview(); // ラベルだけ先に反映（モデル未ロードでも安全）
})();
