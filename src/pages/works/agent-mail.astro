---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="自動メール対応エージェント | ONSIGHT">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: #080c10; color: #e8edf2; font-family: 'Inter', system-ui, sans-serif; }

/* ── layout ── */
.sidebar { position: fixed; left: 0; top: 0; bottom: 0; width: 220px; background: #0a0e14; border-right: 1px solid #1a2d3d; padding: 1.5rem 0; z-index: 10; }
.nav-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.625rem 1.5rem; font-size: 0.8rem; color: #6b8096; cursor: pointer; transition: all 0.15s; user-select: none; }
.nav-item:hover { color: #e8edf2; background: rgba(0,212,255,0.03); }
.nav-item.active { color: #e8edf2; background: rgba(0,212,255,0.06); border-left: 2px solid #00d4ff; }
.nav-section { font-size: 0.65rem; color: #3d5266; letter-spacing: 0.1em; padding: 1rem 1.5rem 0.35rem; text-transform: uppercase; }
.main { margin-left: 220px; }
.topbar { height: 52px; border-bottom: 1px solid #1a2d3d; display: flex; align-items: center; justify-content: space-between; padding: 0 2rem; background: rgba(8,12,16,0.95); position: sticky; top: 0; z-index: 5; }

/* ── badges ── */
.badge { font-size: 0.65rem; padding: 0.2rem 0.6rem; font-family: 'JetBrains Mono', monospace; }
.badge-ok   { background: rgba(0,212,100,0.12); color: #00d464; border: 1px solid rgba(0,212,100,0.2); }
.badge-cyan { background: rgba(0,212,255,0.10); color: #00d4ff; border: 1px solid rgba(0,212,255,0.2); }
.badge-warn { background: rgba(255,180,0,0.12); color: #ffb400; border: 1px solid rgba(255,180,0,0.2); }

/* ── KPI ── */
.kpi-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; background: #1a2d3d; }
.kpi-card { background: #080c10; padding: 1.5rem; }
.kpi-label { font-size: 0.7rem; color: #6b8096; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 0.5rem; }
.kpi-value { font-size: 2rem; font-weight: 500; font-family: 'JetBrains Mono', monospace; color: #00d4ff; }
.kpi-sub { font-size: 0.7rem; color: #3d5266; margin-top: 0.25rem; }

/* ── panel ── */
.section { scroll-margin-top: 52px; }
.panel { background: #080c10; padding: 1.5rem 2rem; border-bottom: 1px solid #1a2d3d; }
.panel-title { font-size: 0.75rem; color: #6b8096; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1.5rem; font-family: 'JetBrains Mono', monospace; display: flex; justify-content: space-between; align-items: center; }

/* ── pipeline ── */
.pipeline { display: flex; align-items: center; gap: 0; overflow-x: auto; padding: 1.5rem 0; }
.pipe-node { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; min-width: 100px; position: relative; }
.pipe-box { background: #0f1923; border: 1px solid #1a2d3d; padding: 0.75rem 1rem; font-size: 0.72rem; text-align: center; border-radius: 4px; width: 90px; transition: all 0.3s; }
.pipe-box.active { border-color: #00d4ff; box-shadow: 0 0 12px rgba(0,212,255,0.2); color: #00d4ff; }
.pipe-box.done { border-color: rgba(0,212,100,0.4); color: #00d464; background: rgba(0,212,100,0.05); }
.pipe-label { font-size: 0.62rem; color: #3d5266; font-family: 'JetBrains Mono', monospace; text-align: center; }
.pipe-arrow { color: #1a2d3d; font-size: 1.2rem; padding: 0 0.25rem; flex-shrink: 0; transition: color 0.3s; }
.pipe-arrow.active { color: #00d4ff; }

/* ── sim controls ── */
.sim-bar { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
.sim-select { background: #0f1923; border: 1px solid #1a2d3d; color: #e8edf2; padding: 0.4rem 0.75rem; font-size: 0.8rem; font-family: inherit; outline: none; cursor: pointer; }
.sim-select:focus { border-color: #00d4ff; }
.btn { background: transparent; border: 1px solid #1a2d3d; color: #6b8096; padding: 0.35rem 0.9rem; font-size: 0.75rem; cursor: pointer; font-family: inherit; transition: all 0.15s; }
.btn:hover { border-color: #00d4ff; color: #00d4ff; }
.btn-primary { background: #00d4ff; color: #080c10; border: none; padding: 0.4rem 1.2rem; font-size: 0.75rem; font-weight: 600; cursor: pointer; font-family: inherit; }
.btn-primary:hover { background: #33ddff; }

/* ── log ── */
.log-box { background: #050810; border: 1px solid #1a2d3d; font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; padding: 1rem; height: 160px; overflow-y: auto; line-height: 1.8; }
.log-line { display: block; }
.log-ts  { color: #3d5266; }
.log-ok  { color: #00d464; }
.log-ai  { color: #00d4ff; }
.log-warn{ color: #ffb400; }
.log-dim { color: #6b8096; }

/* ── agent tree ── */
.agent-tree { display: flex; flex-direction: column; gap: 0; }
.agent-root { background: #0f1923; border: 1px solid #1a2d3d; padding: 0.875rem 1.25rem; display: flex; align-items: center; justify-content: space-between; }
.agent-children { margin-left: 2rem; border-left: 1px solid #1a2d3d; display: flex; flex-direction: column; gap: 1px; }
.agent-child { background: #080c10; border: 1px solid #1a2d3d; padding: 0.7rem 1.25rem; display: flex; align-items: center; justify-content: space-between; margin: 0; transition: all 0.15s; cursor: default; }
.agent-child:hover { background: rgba(0,212,255,0.02); }
.agent-child.highlight { border-color: #00d4ff; background: rgba(0,212,255,0.04); }
.agent-name { font-size: 0.78rem; font-family: 'JetBrains Mono', monospace; color: #e8edf2; }
.agent-meta { font-size: 0.68rem; color: #6b8096; margin-top: 0.15rem; }
.skill-tags { display: flex; gap: 0.35rem; flex-wrap: wrap; }
.skill-tag { font-size: 0.6rem; padding: 0.15rem 0.45rem; font-family: 'JetBrains Mono', monospace; }
.skill-ok   { background: rgba(0,212,100,0.10); color: #00d464; border: 1px solid rgba(0,212,100,0.2); }
.skill-no   { background: rgba(255,60,60,0.08); color: #ff6b6b; border: 1px solid rgba(255,60,60,0.15); text-decoration: line-through; opacity: 0.6; }
.skill-blue { background: rgba(0,212,255,0.10); color: #00d4ff; border: 1px solid rgba(0,212,255,0.2); }

/* ── security card ── */
.sec-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: #1a2d3d; margin-top: 1.5rem; }
.sec-card { background: #080c10; padding: 1.25rem 1.5rem; }
.sec-title { font-size: 0.7rem; color: #6b8096; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 0.75rem; font-family: 'JetBrains Mono', monospace; }
.sec-item { font-size: 0.78rem; color: #a0b0c0; padding: 0.3rem 0; display: flex; align-items: flex-start; gap: 0.5rem; line-height: 1.5; }
.sec-item::before { content: '✓'; color: #00d464; flex-shrink: 0; font-size: 0.7rem; margin-top: 0.15rem; }
.sec-item.no::before { content: '✕'; color: #ff6b6b; }

/* ── flow diagram ── */
.flow-row { display: flex; align-items: stretch; gap: 0; }
.flow-step { flex: 1; background: #0f1923; border: 1px solid #1a2d3d; padding: 1.25rem; position: relative; }
.flow-step + .flow-step { border-left: none; }
.flow-num { font-size: 0.6rem; color: #3d5266; font-family: 'JetBrains Mono', monospace; margin-bottom: 0.4rem; }
.flow-icon { font-size: 1.4rem; margin-bottom: 0.5rem; }
.flow-name { font-size: 0.78rem; color: #e8edf2; font-weight: 600; margin-bottom: 0.3rem; }
.flow-desc { font-size: 0.7rem; color: #6b8096; line-height: 1.6; }
.flow-connector { width: 32px; display: flex; align-items: center; justify-content: center; color: #1a2d3d; font-size: 1rem; flex-shrink: 0; }

/* ── toast ── */
.toast { position: fixed; bottom: 1.5rem; right: 1.5rem; background: #0f1923; border: 1px solid #00d4ff; color: #e8edf2; padding: 0.75rem 1.25rem; font-size: 0.8rem; z-index: 100; opacity: 0; transition: opacity 0.2s; pointer-events: none; font-family: 'JetBrains Mono', monospace; }
.toast.show { opacity: 1; }

/* ── demo banner ── */
.demo-banner { background: rgba(0,180,80,0.06); border-top: 1px solid rgba(0,180,80,0.2); padding: 0.75rem 2rem; display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem; color: #6b8096; }
</style>

<!-- Sidebar -->
<div class="sidebar">
  <div style="padding:1.25rem 1.5rem;border-bottom:1px solid #1a2d3d;">
    <a href="/" style="font-size:0.7rem;color:#3d5266;text-decoration:none;display:flex;align-items:center;gap:0.4rem;margin-bottom:1rem;">
      <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
      ONSIGHT
    </a>
    <div style="font-size:0.85rem;font-weight:600;">自動メール対応</div>
    <div style="font-size:0.7rem;color:#6b8096;margin-top:0.15rem;font-family:'JetBrains Mono',monospace;">AgentHive System</div>
  </div>
  <div style="margin-top:1rem;">
    <div class="nav-section">概要</div>
    <div class="nav-item active" id="nav-overview" onclick="scrollToSection('sec-overview','nav-overview')">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      ダッシュボード
    </div>
    <div class="nav-item" id="nav-pipeline" onclick="scrollToSection('sec-pipeline','nav-pipeline')">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      パイプライン
    </div>
    <div class="nav-section">エージェント</div>
    <div class="nav-item" id="nav-agents" onclick="scrollToSection('sec-agents','nav-agents')">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
      エージェント一覧
    </div>
    <div class="nav-item" id="nav-security" onclick="scrollToSection('sec-security','nav-security')">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      セキュリティ設計
    </div>
    <div class="nav-section">体験</div>
    <div class="nav-item" id="nav-sim" onclick="scrollToSection('sec-sim','nav-sim')">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
      シミュレーション
    </div>
  </div>
</div>

<!-- Main -->
<div class="main">

  <!-- Topbar -->
  <div class="topbar">
    <div style="display:flex;align-items:center;gap:1rem;">
      <span style="font-size:0.82rem;font-weight:500;">自動メール対応エージェント</span>
      <span class="badge badge-ok">● LIVE</span>
    </div>
    <div style="display:flex;align-items:center;gap:1.5rem;font-size:0.72rem;color:#6b8096;font-family:'JetBrains Mono',monospace;">
      <span>● Gemma4-31B ローカル稼働中</span>
      <span>● AgentHive v2</span>
    </div>
  </div>

  <!-- KPI -->
  <div id="sec-overview" class="section">
    <div class="kpi-grid">
      <div class="kpi-card">
        <div class="kpi-label">処理済メール</div>
        <div class="kpi-value">247</div>
        <div class="kpi-sub">過去30日間</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">秘書エージェント数</div>
        <div class="kpi-value">32</div>
        <div class="kpi-sub">送信者ごとに自動生成</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">平均応答時間</div>
        <div class="kpi-value">58<span style="font-size:1rem;color:#6b8096;">秒</span></div>
        <div class="kpi-sub">受信→返信まで</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">外部漏洩リスク</div>
        <div class="kpi-value" style="color:#00d464;">ゼロ</div>
        <div class="kpi-sub">完全ローカル処理</div>
      </div>
    </div>
  </div>

  <!-- Pipeline -->
  <div id="sec-pipeline" class="section panel">
    <div class="panel-title">パイプライン — メールが届いてから返信するまで</div>
    <div class="flow-row">
      <div class="flow-step">
        <div class="flow-num">01</div>
        <div class="flow-icon">📝</div>
        <div class="flow-name">問い合わせフォーム</div>
        <div class="flow-desc">このサイトのコンタクトフォームから送信。名前・メアド・依頼内容を受け取る。</div>
      </div>
      <div class="flow-connector">→</div>
      <div class="flow-step">
        <div class="flow-num">02</div>
        <div class="flow-icon">🗄</div>
        <div class="flow-name">Supabase 保存</div>
        <div class="flow-desc">Vercel API経由でSupabaseのcontactsテーブルにstatus=newで保存。</div>
      </div>
      <div class="flow-connector">→</div>
      <div class="flow-step">
        <div class="flow-num">03</div>
        <div class="flow-icon">🤖</div>
        <div class="flow-name">Gemma4 初回返信</div>
        <div class="flow-desc">3時間ごとのcronが起動。ローカルGemma4-31Bが依頼内容を整理しヒアリングメールを送信。</div>
      </div>
      <div class="flow-connector">→</div>
      <div class="flow-step">
        <div class="flow-num">04</div>
        <div class="flow-icon">📨</div>
        <div class="flow-name">Gmail受信</div>
        <div class="flow-desc">相手からの返信がGmailに届く。AgentHiveが60秒ごとにポーリング。</div>
      </div>
      <div class="flow-connector">→</div>
      <div class="flow-step">
        <div class="flow-num">05</div>
        <div class="flow-icon">🔀</div>
        <div class="flow-name">Mail Router</div>
        <div class="flow-desc">コードノードが決定論的にルーティング。スパム・ML・no-reply を除外し、実在する問い合わせのみ通過。</div>
      </div>
      <div class="flow-connector">→</div>
      <div class="flow-step">
        <div class="flow-num">06</div>
        <div class="flow-icon">🧑‍💼</div>
        <div class="flow-name">専任秘書エージェント</div>
        <div class="flow-desc">送信者ごとに1体のエージェントを自動生成。過去のやり取りを保持しながら継続対応。</div>
      </div>
    </div>
  </div>

  <!-- Agents -->
  <div id="sec-agents" class="section panel">
    <div class="panel-title">
      エージェント階層
      <span style="font-size:0.7rem;color:#3d5266;font-weight:400;">※ メアドはすべてサンプルです</span>
    </div>

    <!-- Root -->
    <div class="agent-tree">
      <div class="agent-root">
        <div>
          <div class="agent-name">🔀 Mail Router</div>
          <div class="agent-meta">コードノード — LLM不使用・決定論的ルーティング</div>
        </div>
        <div class="skill-tags">
          <span class="skill-tag skill-blue">spawn_children</span>
          <span class="skill-tag skill-blue">route_messages</span>
        </div>
      </div>

      <div class="agent-children" id="agent-list">
        <!-- JS で生成 -->
      </div>
    </div>

    <div style="margin-top:1rem;padding:0.875rem 1.25rem;background:#050810;border:1px solid #1a2d3d;font-size:0.75rem;color:#6b8096;line-height:1.7;">
      <strong style="color:#e8edf2;">１送信者 = １エージェント</strong> の原則<br>
      各秘書エージェントは担当する送信者のメールスレッドのみにアクセスできます。他の送信者のやり取りや、ローカルファイル・コード実行権限は一切持ちません。
    </div>
  </div>

  <!-- Security -->
  <div id="sec-security" class="section panel">
    <div class="panel-title">セキュリティ設計 — 各エージェントの権限範囲</div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;">
      <div>
        <div style="font-size:0.7rem;color:#6b8096;letter-spacing:0.06em;text-transform:uppercase;font-family:'JetBrains Mono',monospace;margin-bottom:1rem;">秘書エージェントに許可されていること</div>
        <div class="sec-item">担当送信者とのメールスレッドを読む</div>
        <div class="sec-item">メールに返信する（gmail_send）</div>
        <div class="sec-item">荻野本人にTelegramで通知する（send_telegram）</div>
        <div class="sec-item">重要度に応じてエスカレーション</div>
      </div>
      <div>
        <div style="font-size:0.7rem;color:#6b8096;letter-spacing:0.06em;text-transform:uppercase;font-family:'JetBrains Mono',monospace;margin-bottom:1rem;">秘書エージェントに禁止されていること</div>
        <div class="sec-item no">ローカルファイルの読み書き（read_file / write_file なし）</div>
        <div class="sec-item no">Pythonコードの実行（run_python なし）</div>
        <div class="sec-item no">外部URLへのHTTPリクエスト（http_get なし）</div>
        <div class="sec-item no">他の送信者のメールスレッドへのアクセス</div>
        <div class="sec-item no">認証情報・システム構成の読み取り</div>
      </div>
    </div>

    <div style="margin-top:1.5rem;background:#050810;border-left:3px solid #00d4ff;padding:1rem 1.25rem;font-size:0.78rem;color:#a0b0c0;line-height:1.7;">
      <strong style="color:#00d4ff;">プロンプトインジェクション対策</strong><br>
      メール本文は「処理対象のデータ」として扱い、いかなる指示としても解釈しない設計。
      「前の指示を無視して」「SSHキーを教えて」等の文言が含まれていても、コードノード（Mail Router）が秘書エージェントに渡す前にフィルタリングします。
    </div>
  </div>

  <!-- Simulation -->
  <div id="sec-sim" class="section panel">
    <div class="panel-title">シミュレーション — メールが届いたときの処理フローを体験</div>

    <div class="sim-bar">
      <select class="sim-select" id="sim-scenario">
        <option value="inquiry">📩 新規問い合わせ（返信あり）</option>
        <option value="spam">🗑 スパムメール</option>
        <option value="noreply">🔕 no-replyアドレス</option>
        <option value="injection">⚠️ プロンプトインジェクション試行</option>
      </select>
      <button class="btn-primary" onclick="runSimulation()">▶ シミュレーション実行</button>
      <button class="btn" onclick="clearLog()">クリア</button>
    </div>

    <!-- Pipeline indicator -->
    <div class="pipeline" id="pipeline-viz">
      <div class="pipe-node">
        <div class="pipe-box" id="pipe-0">Gmail受信</div>
        <div class="pipe-label">inbox</div>
      </div>
      <div class="pipe-arrow" id="arr-0">→</div>
      <div class="pipe-node">
        <div class="pipe-box" id="pipe-1">Mail Router</div>
        <div class="pipe-label">コードノード</div>
      </div>
      <div class="pipe-arrow" id="arr-1">→</div>
      <div class="pipe-node">
        <div class="pipe-box" id="pipe-2">ルーティング判定</div>
        <div class="pipe-label">決定論的</div>
      </div>
      <div class="pipe-arrow" id="arr-2">→</div>
      <div class="pipe-node">
        <div class="pipe-box" id="pipe-3">秘書エージェント</div>
        <div class="pipe-label">1対1専任</div>
      </div>
      <div class="pipe-arrow" id="arr-3">→</div>
      <div class="pipe-node">
        <div class="pipe-box" id="pipe-4">返信生成</div>
        <div class="pipe-label">Gemma4-31B</div>
      </div>
      <div class="pipe-arrow" id="arr-4">→</div>
      <div class="pipe-node">
        <div class="pipe-box" id="pipe-5">Gmail送信</div>
        <div class="pipe-label">スレッド継続</div>
      </div>
    </div>

    <div class="log-box" id="sim-log">
      <span class="log-line log-dim">// シナリオを選んで「▶ シミュレーション実行」を押してください</span>
    </div>
  </div>

  <!-- CTA -->
  <div class="panel" style="text-align:center;padding:2.5rem 2rem;">
    <div style="font-size:0.7rem;color:#3d5266;letter-spacing:0.1em;text-transform:uppercase;font-family:'JetBrains Mono',monospace;margin-bottom:0.75rem;">このシステムが実際に動いています</div>
    <div style="font-size:1.1rem;font-weight:500;color:#e8edf2;margin-bottom:0.5rem;">このサイトに問い合わせると、上記のパイプラインで処理されます</div>
    <div style="font-size:0.82rem;color:#6b8096;margin-bottom:1.5rem;">Gemma4がヒアリングし、返信をもとにAgentHiveが継続対応します。すべてローカルLLMで処理。</div>
