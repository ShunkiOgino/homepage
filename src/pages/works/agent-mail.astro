let simRunning = false;

window.runSimulation = function() {
  if (simRunning) return;
  simRunning = true;

  const scenario = SCENARIOS[document.getElementById('sim-scenario').value];
  const log = document.getElementById('sim-log');
  log.innerHTML = '';

  // パイプラインリセット
  for (let i = 0; i <= 5; i++) {
    const el = document.getElementById('pipe-' + i);
    el.className = 'pipe-box';
    const arr = document.getElementById('arr-' + i);
    if (arr) arr.className = 'pipe-arrow';
  }

  // エージェントハイライトリセット
  document.querySelectorAll('.agent-child').forEach(el => el.classList.remove('highlight'));

  let lastPipe = -1;
  const timers = [];

  scenario.steps.forEach(step => {
    timers.push(setTimeout(() => {
      // パイプライン更新
      if (step.pipe !== lastPipe && lastPipe >= 0) {
        document.getElementById('pipe-' + lastPipe).className = 'pipe-box done';
        const arr = document.getElementById('arr-' + lastPipe);
        if (arr) arr.className = 'pipe-arrow active';
      }
      document.getElementById('pipe-' + step.pipe).className = 'pipe-box ' + step.cls;
      lastPipe = step.pipe;

      // ログ追加
      const line = document.createElement('span');
      line.className = 'log-line';
      line.innerHTML = step.log;
      log.appendChild(line);
      log.scrollTop = log.scrollHeight;

      // エージェントハイライト
      if (scenario.highlight) {
        const el = document.getElementById('agent-' + scenario.highlight);
        if (el) el.classList.add('highlight');
      }
    }, step.delay));
  });

  const totalDelay = Math.max(...scenario.steps.map(s => s.delay)) + 800;
  setTimeout(() => { simRunning = false; }, totalDelay);
};

window.clearLog = function() {
  document.getElementById('sim-log').innerHTML = '<span class="log-line log-dim">// シナリオを選んで「▶ シミュレーション実行」を押してください</span>';
