---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="河川・気象モニタリング | 広島市土木局">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: #080c10; color: #e8edf2; font-family: 'Inter', system-ui, sans-serif; }
.sidebar { position: fixed; left: 0; top: 0; bottom: 0; width: 220px; background: #0a0e14; border-right: 1px solid #1a2d3d; padding: 1.5rem 0; z-index: 10; }
.nav-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.625rem 1.5rem; font-size: 0.8rem; color: #6b8096; cursor: pointer; transition: all 0.15s; user-select: none; }
.nav-item:hover { color: #e8edf2; background: rgba(0,212,255,0.03); }
.nav-item.active { color: #e8edf2; background: rgba(0,212,255,0.06); border-left: 2px solid #00d4ff; }
.nav-section { font-size: 0.65rem; color: #3d5266; letter-spacing: 0.1em; padding: 1rem 1.5rem 0.35rem; text-transform: uppercase; }
.main { margin-left: 220px; }
.topbar { height: 52px; border-bottom: 1px solid #1a2d3d; display: flex; align-items: center; justify-content: space-between; padding: 0 2rem; background: rgba(8,12,16,0.95); position: sticky; top: 0; z-index: 5; }
.badge { font-size: 0.65rem; padding: 0.2rem 0.6rem; font-family: 'JetBrains Mono', monospace; display: inline-block; }
.badge-ok { background: rgba(0,212,100,0.12); color: #00d464; border: 1px solid rgba(0,212,100,0.2); }
.badge-warn { background: rgba(255,180,0,0.12); color: #ffb400; border: 1px solid rgba(255,180,0,0.2); }
.badge-danger { background: rgba(255,60,60,0.12); color: #ff4444; border: 1px solid rgba(255,60,60,0.2); }
.badge-info { background: rgba(0,112,243,0.12); color: #3399ff; border: 1px solid rgba(0,112,243,0.2); }
.section { scroll-margin-top: 52px; }
.kpi-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; background: #1a2d3d; }
.kpi-card { background: #080c10; padding: 1.25rem 1.5rem; }
.kpi-label { font-size: 0.7rem; color: #6b8096; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 0.35rem; }
.kpi-value { font-size: 1.75rem; font-weight: 500; font-family: 'JetBrains Mono', monospace; color: #00d4ff; }
.kpi-sub { font-size: 0.7rem; color: #3d5266; margin-top: 0.2rem; }
.panel { background: #080c10; padding: 1.5rem; border-bottom: 1px solid #1a2d3d; }
.panel-title { font-size: 0.75rem; color: #6b8096; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1.25rem; font-family: 'JetBrains Mono', monospace; display: flex; justify-content: space-between; align-items: center; }
.btn { background: transparent; border: 1px solid #1a2d3d; color: #6b8096; padding: 0.3rem 0.8rem; font-size: 0.75rem; cursor: pointer; font-family: inherit; transition: all 0.15s; }
.btn:hover { border-color: #00d4ff; color: #00d4ff; }
.btn.active { border-color: #00d4ff; color: #00d4ff; background: rgba(0,212,255,0.06); }
.forecast-strip { display: flex; gap: 1px; background: #1a2d3d; }
.forecast-cell { background: #080c10; padding: 0.75rem 0.5rem; text-align: center; flex: 1; font-size: 0.72rem; }
.weather-row { display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 0; border-bottom: 1px solid rgba(26,45,61,0.5); }
.weather-label { font-size: 0.72rem; color: #6b8096; }
.weather-value { font-family: 'JetBrains Mono', monospace; font-size: 0.82rem; color: #e8edf2; }
.source-note { font-size: 0.7rem; color: #3d5266; padding: 1rem 0; display: flex; gap: 1.5rem; flex-wrap: wrap; }
.source-dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; margin-right: 0.4rem; vertical-align: middle; }
.demo-banner { background: rgba(0,112,243,0.08); border-top: 1px solid rgba(0,112,243,0.2); padding: 0.75rem 2rem; display: flex; justify-content: space-between; align-items: center; }
.loading-text { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #3d5266; animation: blink 1.2s step-end infinite; }
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }
.toast { position: fixed; bottom: 1.5rem; right: 1.5rem; background: #0f1923; border: 1px solid #00d4ff; color: #e8edf2; padding: 0.75rem 1.25rem; font-size: 0.8rem; z-index: 100; opacity: 0; transition: opacity 0.2s; pointer-events: none; font-family: 'JetBrains Mono', monospace; }
.toast.show { opacity: 1; }
</style>

<div class="sidebar">
  <div style="padding:1.25rem 1.5rem;border-bottom:1px solid #1a2d3d;">
    <div style="font-size:0.85rem;font-weight:600;">広島市土木局</div>
    <div style="font-size:0.7rem;color:#6b8096;margin-top:0.15rem;font-family:'JetBrains Mono',monospace;">河川・気象モニタリング</div>
  </div>
  <div style="margin-top:1rem;">
    <div class="nav-section">モニタリング</div>
    <div class="nav-item active" id="nav-top" onclick="scrollToSection('sec-kpi','nav-top')">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      ダッシュボード
    </div>
    <div class="nav-item" id="nav-river" onclick="scrollToSection('sec-chart','nav-river')">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      水位推移
    </div>
    <div class="nav-item" id="nav-weather" onclick="scrollToSection('sec-weather','nav-weather')">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
      気象情報
    </div>
    <div class="nav-section">観測所</div>
    <div class="nav-item" id="nav-stations" onclick="scrollToSection('sec-stations','nav-stations')">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
      観測所一覧
    </div>
  </div>
</div>

<div class="main">
  <div class="topbar">
    <div style="display:flex;align-items:center;gap:0.75rem;">
      <span style="font-family:'JetBrains Mono',monospace;font-size:0.75rem;color:#6b8096;">太田川流域</span>
      <span class="badge" id="alert-badge">読込中</span>
      <span class="loading-text" id="loading-indicator">取得中...</span>
    </div>
    <div style="display:flex;align-items:center;gap:0.75rem;">
      <span style="font-size:0.7rem;color:#3d5266;" id="update-time">—</span>
      <button class="btn" onclick="refresh()" style="font-size:0.65rem;">↺ 更新</button>
    </div>
  </div>

  <div id="sec-kpi" class="section kpi-grid">
    <div class="kpi-card">
      <div class="kpi-label">現在気温</div>
      <div class="kpi-value" id="kpi-temp"><span class="loading-text">—</span></div>
      <div class="kpi-sub" id="kpi-temp-sub">広島市 AMEDAS</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">降水量（1時間）</div>
      <div class="kpi-value" id="kpi-precip"><span class="loading-text">—</span></div>
      <div class="kpi-sub" id="kpi-precip-sub">mm/hr</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">水位（祇園観測所）</div>
      <div class="kpi-value" id="kpi-level"><span class="loading-text">—</span></div>
      <div class="kpi-sub">平常水位: 1.2〜1.8m</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">アラートレベル</div>
      <div class="kpi-value" style="font-size:1.1rem;padding-top:0.35rem;" id="kpi-alert"><span class="loading-text">—</span></div>
      <div class="kpi-sub" id="kpi-alert-sub">—</div>
    </div>
  </div>

  <div id="sec-chart" class="section panel">
    <div class="panel-title">
      <span>水位推移 — 太田川 祇園観測所</span>
      <div style="display:flex;gap:0.5rem;align-items:center;">
        <button class="btn active" id="range-24" onclick="setRange(24)" style="font-size:0.65rem;">24時間</button>
        <button class="btn" id="range-48" onclick="setRange(48)" style="font-size:0.65rem;">48時間</button>
      </div>
    </div>
    <svg id="water-chart" viewBox="0 0 800 220" style="width:100%;height:auto;display:block;" preserveAspectRatio="xMidYMid meet"></svg>
    <div style="margin-top:1.5rem;">
      <div class="panel-title" style="margin-bottom:0.75rem;">
        <span>降水量（推定）</span>
      </div>
      <svg id="precip-chart" viewBox="0 0 800 80" style="width:100%;height:auto;display:block;" preserveAspectRatio="xMidYMid meet"></svg>
    </div>
    <div class="source-note" style="margin-top:1rem;border-top:1px solid #1a2d3d;padding-top:0.75rem;">
      <span><span class="source-dot" style="background:#00d4ff;"></span>天気・気温：気象庁 AMEDAS（実データ）</span>
      <span><span class="source-dot" style="background:#ffb400;"></span>水位：太田川実績値に基づくサンプルデータ（本番環境では国交省 川の防災情報APIと連携）</span>
    </div>
  </div>

  <div id="sec-weather" class="section" style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#1a2d3d;">
    <div class="panel">
      <div class="panel-title">現在の気象（広島市）</div>
      <div id="weather-detail">
        <div class="weather-row"><span class="weather-label">気温</span><span class="weather-value" id="w-temp">—</span></div>
        <div class="weather-row"><span class="weather-label">湿度</span><span class="weather-value" id="w-hum">—</span></div>
        <div class="weather-row"><span class="weather-label">降水量（1時間）</span><span class="weather-value" id="w-prec">—</span></div>
        <div class="weather-row"><span class="weather-label">風速</span><span class="weather-value" id="w-wind">—</span></div>
        <div class="weather-row"><span class="weather-label">風向</span><span class="weather-value" id="w-wdir">—</span></div>
        <div class="weather-row" style="border:none;"><span class="weather-label">天気</span><span class="weather-value" id="w-sky">—</span></div>
      </div>
    </div>
    <div class="panel" style="border-left:1px solid #1a2d3d;">
      <div class="panel-title">48時間 降水確率予報</div>
      <div class="forecast-strip" id="forecast-strip" style="margin-bottom:1rem;">
        <div class="forecast-cell" style="color:#3d5266;">読込中...</div>
      </div>
      <div style="font-size:0.75rem;color:#6b8096;margin-bottom:0.5rem;" id="forecast-weather-label">—</div>
      <div style="font-size:0.72rem;color:#3d5266;" id="forecast-source">出典: 気象庁 天気予報</div>
    </div>
  </div>

  <div id="sec-stations" class="section panel">
    <div class="panel-title">観測所一覧（太田川水系）</div>
    <table style="width:100%;border-collapse:collapse;font-size:0.82rem;">
      <thead>
        <tr>
          <th style="text-align:left;padding:0.5rem 0.75rem;color:#3d5266;font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;border-bottom:1px solid #1a2d3d;font-weight:400;">観測所名</th>
          <th style="text-align:left;padding:0.5rem 0.75rem;color:#3d5266;font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;border-bottom:1px solid #1a2d3d;font-weight:400;">河川</th>
          <th style="text-align:left;padding:0.5rem 0.75rem;color:#3d5266;font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;border-bottom:1px solid #1a2d3d;font-weight:400;">現在水位</th>
          <th style="text-align:left;padding:0.5rem 0.75rem;color:#3d5266;font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;border-bottom:1px solid #1a2d3d;font-weight:400;">待機水位</th>
          <th style="text-align:left;padding:0.5rem 0.75rem;color:#3d5266;font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;border-bottom:1px solid #1a2d3d;font-weight:400;">注意水位</th>
          <th style="text-align:left;padding:0.5rem 0.75rem;color:#3d5266;font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;border-bottom:1px solid #1a2d3d;font-weight:400;">状態</th>
        </tr>
      </thead>
      <tbody id="stations-tbody"></tbody>
    </table>
  </div>

  <div class="demo-banner">
    <span style="font-size:0.75rem;color:#6b8096;">このページは荻野舜樹（ONSIGHT）によるデモです。天気は本物、水位はサンプルデータです。</span>
    <a href="/" style="font-size:0.75rem;color:#00d4ff;text-decoration:none;">← ポートフォリオに戻る</a>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
// ─── 定数 ─────────────────────────────────────────────
const THRESHOLDS = { standby: 3.20, watch: 4.10, evacuate: 5.00, danger: 5.50 };
const AMEDAS_STATION = '67437'; // 広島
const FORECAST_AREA = '340000'; // 広島県
const WIND_DIR = ['北','北北東','北東','東北東','東','東南東','南東','南南東','南','南南西','南西','西南西','西','西北西','北西','北北西'];

const STATIONS = [
  { name: '祇園', river: '太田川', standby: 3.20, watch: 4.10, evacuate: 5.00, danger: 5.50 },
  { name: '水内橋', river: '太田川', standby: 2.80, watch: 3.60, evacuate: 4.40, danger: 4.90 },
  { name: '三篠橋', river: '三篠川', standby: 2.40, watch: 3.20, evacuate: 3.80, danger: 4.20 },
  { name: '落合', river: '根の谷川', standby: 1.80, watch: 2.50, evacuate: 3.10, danger: 3.50 },
];

// ─── 状態 ─────────────────────────────────────────────
let currentPrecip1h = 0;
let waterLevels24 = [];
let waterLevels48 = [];
let precipHourly24 = [];
let precipHourly48 = [];
let currentRange = 24;

// ─── ユーティリティ ────────────────────────────────────
function toast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2500);
}

function scrollToSection(id, navId) {
  document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
  document.getElementById(navId).classList.add('active');
  document.getElementById(id).scrollIntoView({ behavior: 'smooth' });
}

function setRange(n) {
  currentRange = n;
  document.getElementById('range-24').classList.toggle('active', n === 24);
  document.getElementById('range-48').classList.toggle('active', n === 48);
  renderCharts();
}

function getAlertLevel(level) {
  if (level >= THRESHOLDS.danger)   return { label: '氾濫危険', cls: 'badge-danger', color: '#ff4444', sub: '直ちに安全確保' };
  if (level >= THRESHOLDS.evacuate) return { label: '避難判断', cls: 'badge-danger', color: '#ff6600', sub: '避難開始を検討' };
  if (level >= THRESHOLDS.watch)    return { label: '氾濫注意', cls: 'badge-warn', color: '#ffb400', sub: '水防団活動開始' };
  if (level >= THRESHOLDS.standby)  return { label: '水防団待機', cls: 'badge-warn', color: '#ffdd00', sub: '注意して監視' };
  return { label: '平常', cls: 'badge-ok', color: '#00d464', sub: '異常なし' };
}

// ─── サンプル水位データ生成 ─────────────────────────────
function generateWaterLevels(hours, precip1h) {
  const base = 1.35;
  const levels = [];
  const precips = [];
  const now = new Date();
  const nowHour = now.getHours();

  // 過去 hours 時間分の降水量パターン（過去→現在）
  for (let i = 0; i < hours; i++) {
    const h = (nowHour - hours + i + 24) % 24;
    // 典型的な広島の日中パターン
    let p = 0;
    if (h >= 14 && h <= 17) p = 2 + Math.random() * 3; // 午後に雨多い
    else if (h >= 7 && h <= 9) p = Math.random() * 1.5;
    else p = Math.random() * 0.3;
    precips.push(Math.round(p * 10) / 10);
  }
  // 直近1時間は実データ（AMEDASから取得済み）で上書き
  precips[precips.length - 1] = precip1h;

  // 水位計算（降水の2〜3時間後に水位が上がる）
  let level = base;
  for (let i = 0; i < hours; i++) {
    // 自然変動（潮汐の影響 ±0.15m）
    const h = (nowHour - hours + i + 24) % 24;
    const tidal = 0.12 * Math.sin((h / 12) * Math.PI);
    // 降水効果（2〜3時間ラグ、6〜8時間かけて減衰）
    let rainEffect = 0;
    for (let lag = 2; lag <= 8; lag++) {
      const pi = i - lag;
      if (pi >= 0) rainEffect += precips[pi] * 0.28 * Math.exp(-0.35 * (lag - 2));
    }
    level = base + tidal + rainEffect + (Math.random() - 0.5) * 0.04;
    level = Math.max(0.6, Math.round(level * 100) / 100);
    levels.push(level);
  }
  return { levels, precips };
}

// ─── SVG チャート ──────────────────────────────────────
const SVG_W = 800, SVG_H = 220;
const M = { top: 15, right: 30, bottom: 30, left: 48 };
const CW = SVG_W - M.left - M.right;
const CH = SVG_H - M.top - M.bottom;
const MAX_Y = 7.0;

function lv2y(lv) { return M.top + CH * (1 - lv / MAX_Y); }
function idx2x(i, n) { return M.left + (i / (n - 1)) * CW; }

function buildWaterSVG(levels, hours) {
  const n = levels.length;
  const now = new Date();

  // ゾーン背景
  const zones = [
    { min: THRESHOLDS.danger, max: MAX_Y, fill: 'rgba(255,60,60,0.07)' },
    { min: THRESHOLDS.evacuate, max: THRESHOLDS.danger, fill: 'rgba(255,100,0,0.06)' },
    { min: THRESHOLDS.watch, max: THRESHOLDS.evacuate, fill: 'rgba(255,180,0,0.05)' },
    { min: THRESHOLDS.standby, max: THRESHOLDS.watch, fill: 'rgba(255,220,0,0.04)' },
  ];
  const zoneRects = zones.map(z =>
    `<rect x="${M.left}" y="${lv2y(z.max)}" width="${CW}" height="${lv2y(z.min)-lv2y(z.max)}" fill="${z.fill}"/>`
  ).join('');

  // 警戒水位ライン
  const thLines = [
    { lv: THRESHOLDS.standby, label: '待機 3.2m', color: '#cccc00' },
    { lv: THRESHOLDS.watch,   label: '注意 4.1m', color: '#ffb400' },
    { lv: THRESHOLDS.evacuate,label: '避難 5.0m', color: '#ff6600' },
    { lv: THRESHOLDS.danger,  label: '危険 5.5m', color: '#ff4444' },
  ].map(t => {
    const y = lv2y(t.lv);
    return `<line x1="${M.left}" y1="${y}" x2="${M.left+CW}" y2="${y}" stroke="${t.color}" stroke-width="1" stroke-dasharray="5,4" opacity="0.55"/>
    <text x="${M.left+CW+4}" y="${y+3.5}" fill="${t.color}" font-size="9.5" font-family="JetBrains Mono,monospace">${t.label}</text>`;
  }).join('');

  // 水位ポリライン
  const pts = levels.map((l, i) => `${idx2x(i, n)},${lv2y(l)}`).join(' ');
  const lastX = idx2x(n-1, n);
  const areaPath = `M ${M.left},${lv2y(levels[0])} L ${pts} L ${lastX},${M.top+CH} L ${M.left},${M.top+CH} Z`;

  // Y軸ラベル
  const yLabels = [0,1,2,3,4,5,6].map(v =>
    `<text x="${M.left-6}" y="${lv2y(v)+4}" text-anchor="end" fill="#3d5266" font-size="10" font-family="JetBrains Mono,monospace">${v}m</text>`
  ).join('');

  // X軸ラベル（hours に応じて間隔調整）
  const step = hours <= 24 ? 4 : 8;
  const xLabels = levels.map((_, i) => {
    if (i % step !== 0) return '';
    const d = new Date(now.getTime() - (n - 1 - i) * 3600000);
    const label = `${String(d.getHours()).padStart(2,'0')}:00`;
    return `<text x="${idx2x(i,n)}" y="${M.top+CH+16}" text-anchor="middle" fill="#3d5266" font-size="9.5" font-family="JetBrains Mono,monospace">${label}</text>`;
  }).join('');

  // 現在時刻ライン
  const nowX = idx2x(n-1, n);
  const nowLine = `<line x1="${nowX}" y1="${M.top}" x2="${nowX}" y2="${M.top+CH}" stroke="rgba(0,212,255,0.25)" stroke-width="1"/>
  <text x="${nowX}" y="${M.top-3}" text-anchor="middle" fill="rgba(0,212,255,0.5)" font-size="9" font-family="JetBrains Mono,monospace">現在</text>`;

  return `
    <defs>
      <linearGradient id="wg" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#00d4ff" stop-opacity="0.25"/>
        <stop offset="100%" stop-color="#00d4ff" stop-opacity="0.03"/>
      </linearGradient>
    </defs>
    ${zoneRects}
    <line x1="${M.left}" y1="${M.top}" x2="${M.left}" y2="${M.top+CH}" stroke="#1a2d3d" stroke-width="1"/>
    <line x1="${M.left}" y1="${M.top+CH}" x2="${M.left+CW}" y2="${M.top+CH}" stroke="#1a2d3d" stroke-width="1"/>
    ${thLines}
    <path d="${areaPath}" fill="url(#wg)"/>
    <polyline points="${pts}" fill="none" stroke="#00d4ff" stroke-width="2" stroke-linejoin="round"/>
    <circle cx="${idx2x(n-1,n)}" cy="${lv2y(levels[n-1])}" r="4" fill="#00d4ff"/>
    ${nowLine}
    ${yLabels}${xLabels}
  `;
}

function buildPrecipSVG(precips) {
  const n = precips.length;
  const maxP = Math.max(...precips, 5);
  const barW = CW / n * 0.75;
  const PM = { top: 8, right: 30, bottom: 20, left: 48 };
  const PCH = 80 - PM.top - PM.bottom;
  const bars = precips.map((p, i) => {
    const x = PM.left + (i / n) * (SVG_W - PM.left - PM.right);
    const h = (p / maxP) * PCH;
    const y = PM.top + PCH - h;
    const color = p >= 10 ? '#ff4444' : p >= 5 ? '#ffb400' : p > 0 ? '#3399ff' : '#1a2d3d';
    return `<rect x="${x - barW/2}" y="${y}" width="${barW}" height="${h}" fill="${color}" opacity="0.8"/>`;
  }).join('');

  // Y軸
  const yL = `<text x="${PM.left-6}" y="${PM.top+4}" text-anchor="end" fill="#3d5266" font-size="9" font-family="JetBrains Mono,monospace">${maxP}mm</text>
  <text x="${PM.left-6}" y="${PM.top+PCH+4}" text-anchor="end" fill="#3d5266" font-size="9" font-family="JetBrains Mono,monospace">0</text>`;

  return `<line x1="${PM.left}" y1="${PM.top}" x2="${PM.left}" y2="${PM.top+PCH}" stroke="#1a2d3d" stroke-width="1"/>
  <line x1="${PM.left}" y1="${PM.top+PCH}" x2="${PM.left+(SVG_W-PM.left-PM.right)}" y2="${PM.top+PCH}" stroke="#1a2d3d" stroke-width="1"/>
  ${bars}${yL}`;
}

function renderCharts() {
  const levels = currentRange === 24 ? waterLevels24 : waterLevels48;
  const precips = currentRange === 24 ? precipHourly24 : precipHourly48;
  if (!levels.length) return;
  document.getElementById('water-chart').innerHTML = buildWaterSVG(levels, currentRange);
  document.getElementById('precip-chart').innerHTML = buildPrecipSVG(precips);
}

// ─── KPI / アラート更新 ─────────────────────────────────
function updateKPI(currentLevel) {
  const al = getAlertLevel(currentLevel);
  document.getElementById('kpi-level').textContent = currentLevel.toFixed(2) + 'm';
  document.getElementById('kpi-alert').innerHTML = `<span class="badge ${al.cls}" style="font-size:0.85rem;padding:0.3rem 0.7rem;">${al.label}</span>`;
  document.getElementById('kpi-alert-sub').textContent = al.sub;
  document.getElementById('alert-badge').textContent = al.label;
  document.getElementById('alert-badge').className = `badge ${al.cls}`;
}

function renderStations(currentLevel) {
  const tbody = document.getElementById('stations-tbody');
  tbody.innerHTML = STATIONS.map((s, idx) => {
    // 祇園は実際の水位、他は相対的に計算
    const factor = [1.0, 0.88, 0.72, 0.61][idx];
    const lv = Math.round(currentLevel * factor * 100) / 100;
    const al = getAlertLevel(lv);
    return `<tr>
      <td style="padding:0.7rem 0.75rem;border-bottom:1px solid rgba(26,45,61,0.5);font-weight:500;">${s.name}</td>
      <td style="padding:0.7rem 0.75rem;border-bottom:1px solid rgba(26,45,61,0.5);color:#6b8096;font-size:0.78rem;">${s.river}</td>
      <td style="padding:0.7rem 0.75rem;border-bottom:1px solid rgba(26,45,61,0.5);font-family:'JetBrains Mono',monospace;color:#00d4ff;">${lv.toFixed(2)}m</td>
      <td style="padding:0.7rem 0.75rem;border-bottom:1px solid rgba(26,45,61,0.5);font-family:'JetBrains Mono',monospace;color:#6b8096;">${s.standby.toFixed(2)}m</td>
      <td style="padding:0.7rem 0.75rem;border-bottom:1px solid rgba(26,45,61,0.5);font-family:'JetBrains Mono',monospace;color:#6b8096;">${s.watch.toFixed(2)}m</td>
      <td style="padding:0.7rem 0.75rem;border-bottom:1px solid rgba(26,45,61,0.5);"><span class="badge ${al.cls}">${al.label}</span></td>
    </tr>`;
  }).join('');
}

// ─── JMA データ取得 ────────────────────────────────────
async function fetchAMEDAS() {
  try {
    // 最新時刻を取得
    const timeRes = await fetch('https://www.jma.go.jp/bosai/amedas/data/latest_time.txt');
    const timeStr = await timeRes.text(); // "2026-05-28T06:00:00+09:00"
    const d = new Date(timeStr.trim());
    const ymd = `${d.getFullYear()}${String(d.getMonth()+1).padStart(2,'0')}${String(d.getDate()).padStart(2,'0')}`;
    const hms = `${String(d.getHours()).padStart(2,'0')}0000`;
    const url = `https://www.jma.go.jp/bosai/amedas/data/point/${AMEDAS_STATION}/${ymd}_${hms}.json`;
    const res = await fetch(url);
    const json = await res.json();

    // 気温
    const temp = json.temp?.[0];
    const hum = json.humidity?.[0];
    const prec = json.precipitation1h?.[0] ?? 0;
    const wind = json.wind?.[0];
    const wdir = json.windDirection?.[0];

    document.getElementById('kpi-temp').textContent = temp != null ? temp.toFixed(1) + '°C' : '—';
    document.getElementById('kpi-precip').textContent = prec != null ? prec.toFixed(1) + 'mm' : '0.0mm';
    document.getElementById('w-temp').textContent = temp != null ? temp.toFixed(1) + '°C' : '—';
    document.getElementById('w-hum').textContent = hum != null ? hum + '%' : '—';
    document.getElementById('w-prec').textContent = prec != null ? prec.toFixed(1) + 'mm/hr' : '0.0mm/hr';
    document.getElementById('w-wind').textContent = wind != null ? wind.toFixed(1) + 'm/s' : '—';
    document.getElementById('w-wdir').textContent = (wdir != null && WIND_DIR[wdir]) ? WIND_DIR[wdir] : '—';

    const label = temp != null ? `広島市 気温 ${temp.toFixed(1)}°C` : '広島市';
    document.getElementById('kpi-temp-sub').textContent = `更新: ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;

    currentPrecip1h = prec ?? 0;
    return true;
  } catch (e) {
    console.warn('AMEDAS fetch failed:', e);
    // フォールバック
    document.getElementById('kpi-temp').textContent = '—';
    document.getElementById('kpi-precip').textContent = '—';
    return false;
  }
}

async function fetchForecast() {
  try {
    const res = await fetch(`https://www.jma.go.jp/bosai/forecast/data/forecast/${FORECAST_AREA}.json`);
    const json = await res.json();
    const ts = json[0]?.timeSeries;
    if (!ts) return;

    // 天気概況
    const weatherArea = ts[0]?.areas?.find(a => a.area?.name === '南部');
    if (weatherArea?.weathers?.[0]) {
      document.getElementById('w-sky').textContent = weatherArea.weathers[0].replace(/\s+/g, ' ').trim().slice(0, 20);
      document.getElementById('forecast-weather-label').textContent = weatherArea.weathers[0].trim().slice(0, 40);
    }

    // 降水確率
    const popArea = ts[1]?.areas?.find(a => a.area?.name === '南部');
    const pops = popArea?.pops ?? [];
    const times = ts[1]?.timeDefines ?? [];
    if (pops.length > 0) {
      const cells = pops.slice(0, 8).map((p, i) => {
        const dt = times[i] ? new Date(times[i]) : null;
        const label = dt ? `${String(dt.getMonth()+1)}/${String(dt.getDate())} ${String(dt.getHours()).padStart(2,'0')}時` : `+${i*6}h`;
        const pct = parseInt(p) || 0;
        const color = pct >= 60 ? '#ff4444' : pct >= 40 ? '#ffb400' : pct >= 20 ? '#3399ff' : '#3d5266';
        return `<div class="forecast-cell">
          <div style="font-size:0.65rem;color:#3d5266;margin-bottom:0.3rem;">${label}</div>
          <div style="font-size:1rem;font-family:'JetBrains Mono',monospace;color:${color};font-weight:500;">${p}%</div>
        </div>`;
      }).join('');
      document.getElementById('forecast-strip').innerHTML = cells;
    }

    document.getElementById('forecast-source').textContent = '出典: 気象庁 天気予報（広島県南部）';
    return true;
  } catch (e) {
    console.warn('Forecast fetch failed:', e);
    document.getElementById('forecast-strip').innerHTML = '<div class="forecast-cell" style="color:#3d5266;">取得できませんでした</div>';
    return false;
  }
}

// ─── メイン処理 ────────────────────────────────────────
async function refresh() {
  document.getElementById('loading-indicator').style.display = 'inline';
  try {
    await fetchAMEDAS();
    await fetchForecast();
  } catch(e) {}

  // 水位サンプルデータ生成
  const r24 = generateWaterLevels(25, currentPrecip1h);
  const r48 = generateWaterLevels(49, currentPrecip1h);
  waterLevels24 = r24.levels;
  precipHourly24 = r24.precips;
  waterLevels48 = r48.levels;
  precipHourly48 = r48.precips;

  const currentLevel = waterLevels24[waterLevels24.length - 1];
  updateKPI(currentLevel);
  renderCharts();
  renderStations(currentLevel);

  const now = new Date();
  document.getElementById('update-time').textContent =
    `最終更新 ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}:${String(now.getSeconds()).padStart(2,'0')}`;
  document.getElementById('loading-indicator').style.display = 'none';
  toast('データを更新しました');
}

// onclick 属性から呼べるようにグローバルに登録
window.scrollToSection = scrollToSection;
window.setRange = setRange;
window.refresh = refresh;

document.getElementById('loading-indicator').style.display = 'inline';
refresh();
</script>
