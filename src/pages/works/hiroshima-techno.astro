---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="社内問い合わせ管理 | 広島テクノサービス株式会社">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: #080c10; color: #e8edf2; font-family: 'Inter', system-ui, sans-serif; }
.sidebar { position: fixed; left: 0; top: 0; bottom: 0; width: 220px; background: #0a0e14; border-right: 1px solid #1a2d3d; padding: 1.5rem 0; z-index: 10; }
.nav-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.625rem 1.5rem; font-size: 0.8rem; color: #6b8096; cursor: pointer; }
.nav-item.active { color: #e8edf2; background: rgba(0,212,255,0.06); border-left: 2px solid #00d4ff; }
.nav-section { font-size: 0.65rem; color: #3d5266; letter-spacing: 0.1em; padding: 1rem 1.5rem 0.35rem; text-transform: uppercase; }
.main { margin-left: 220px; }
.topbar { height: 52px; border-bottom: 1px solid #1a2d3d; display: flex; align-items: center; justify-content: space-between; padding: 0 2rem; background: rgba(8,12,16,0.95); position: sticky; top: 0; z-index: 5; }
.badge { font-size: 0.65rem; padding: 0.2rem 0.6rem; font-family: 'JetBrains Mono', monospace; display: inline-block; cursor: default; }
.badge-high { background: rgba(255,60,60,0.12); color: #ff4444; border: 1px solid rgba(255,60,60,0.2); }
.badge-mid { background: rgba(255,180,0,0.12); color: #ffb400; border: 1px solid rgba(255,180,0,0.2); }
.badge-low { background: rgba(0,112,243,0.12); color: #3399ff; border: 1px solid rgba(0,112,243,0.2); }
.badge-open { background: rgba(255,60,60,0.08); color: #ff6666; border: 1px solid rgba(255,60,60,0.2); cursor: pointer; transition: all 0.15s; }
.badge-open:hover { background: rgba(255,60,60,0.2); }
.badge-inprog { background: rgba(255,180,0,0.08); color: #ffb400; border: 1px solid rgba(255,180,0,0.2); cursor: pointer; transition: all 0.15s; }
.badge-inprog:hover { background: rgba(255,180,0,0.2); }
.badge-done { background: rgba(0,212,100,0.06); color: #6b8096; border: 1px solid #1a2d3d; cursor: pointer; transition: all 0.15s; }
.badge-done:hover { background: rgba(0,212,100,0.1); color: #00d464; }
.panel { background: #080c10; padding: 1.5rem; border-bottom: 1px solid #1a2d3d; }
.panel-title { font-size: 0.75rem; color: #6b8096; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1.25rem; font-family: 'JetBrains Mono', monospace; display: flex; justify-content: space-between; align-items: center; }
table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
th { text-align: left; padding: 0.5rem 0.75rem; color: #3d5266; font-size: 0.7rem; letter-spacing: 0.05em; text-transform: uppercase; border-bottom: 1px solid #1a2d3d; font-weight: 400; }
td { padding: 0.7rem 0.75rem; border-bottom: 1px solid rgba(26,45,61,0.5); vertical-align: middle; }
tr:hover td { background: rgba(0,212,255,0.015); }
.btn { background: transparent; border: 1px solid #1a2d3d; color: #6b8096; padding: 0.3rem 0.8rem; font-size: 0.75rem; cursor: pointer; font-family: inherit; transition: all 0.15s; }
.btn:hover { border-color: #00d4ff; color: #00d4ff; }
.btn-primary { background: #00d4ff; color: #080c10; border: none; padding: 0.4rem 1rem; font-size: 0.75rem; cursor: pointer; font-weight: 600; font-family: inherit; }
.btn-primary:hover { background: #33ddff; }
.btn-danger { color: #ff4444; border-color: rgba(255,60,60,0.2); }
.btn-danger:hover { border-color: #ff4444; background: rgba(255,60,60,0.08); }
.tab { font-size: 0.78rem; padding: 0.5rem 1rem; color: #6b8096; border-bottom: 2px solid transparent; cursor: pointer; transition: all 0.15s; white-space: nowrap; }
.tab.active { color: #e8edf2; border-bottom-color: #00d4ff; }
.tab:hover:not(.active) { color: #e8edf2; }
.add-panel { background: #0f1923; border: 1px solid #1a2d3d; padding: 1.5rem; margin-bottom: 1.5rem; display: none; }
.add-panel.open { display: block; }
.form-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem; }
.form-field label { font-size: 0.65rem; color: #6b8096; font-family: 'JetBrains Mono', monospace; display: block; margin-bottom: 0.35rem; letter-spacing: 0.05em; }
.form-field input, .form-field select { width: 100%; background: #080c10; border: 1px solid #1a2d3d; color: #e8edf2; padding: 0.5rem 0.75rem; font-size: 0.8rem; font-family: inherit; outline: none; }
.form-field input:focus, .form-field select:focus { border-color: #00d4ff; }
.assignee-select { background: #0a0e14; border: 1px solid #1a2d3d; color: #e8edf2; font-size: 0.75rem; padding: 0.2rem 0.4rem; font-family: inherit; cursor: pointer; outline: none; }
.demo-banner { background: rgba(0,112,243,0.08); border-top: 1px solid rgba(0,112,243,0.2); padding: 0.75rem 2rem; display: flex; justify-content: space-between; align-items: center; }
.toast { position: fixed; bottom: 1.5rem; right: 1.5rem; background: #0f1923; border: 1px solid #00d4ff; color: #e8edf2; padding: 0.75rem 1.25rem; font-size: 0.8rem; z-index: 100; opacity: 0; transition: opacity 0.2s; pointer-events: none; font-family: 'JetBrains Mono', monospace; }
.toast.show { opacity: 1; }
</style>

<div class="sidebar">
  <div style="padding:1.25rem 1.5rem;border-bottom:1px solid #1a2d3d;">
    <div style="font-size:0.85rem;font-weight:600;">広島テクノサービス㈱</div>
    <div style="font-size:0.7rem;color:#6b8096;margin-top:0.15rem;font-family:'JetBrains Mono',monospace;">ヘルプデスク管理</div>
  </div>
  <div style="margin-top:1rem;">
    <div class="nav-section">チケット</div>
    <div class="nav-item active">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="2"/></svg>
      チケット一覧
    </div>
    <div class="nav-item">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      統計
    </div>
  </div>
</div>

<div class="main">
  <div class="topbar">
    <div style="display:flex;align-items:center;gap:0.75rem;">
      <span style="font-family:'JetBrains Mono',monospace;font-size:0.75rem;color:#6b8096;">チケット管理</span>
      <span class="badge badge-open" id="topbar-open" style="display:none;"></span>
    </div>
    <div style="display:flex;align-items:center;gap:0.75rem;">
      <span style="font-size:0.7rem;color:#3d5266;">データはブラウザに保存されます</span>
      <button class="btn" onclick="resetData()" style="font-size:0.65rem;">リセット</button>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#1a2d3d;">
    <div style="background:#080c10;padding:1.25rem 1.5rem;">
      <div style="font-size:0.7rem;color:#6b8096;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.4rem;">未対応</div>
      <div style="font-size:1.75rem;font-weight:500;font-family:'JetBrains Mono',monospace;color:#ff4444;" id="kpi-open">—</div>
    </div>
    <div style="background:#080c10;padding:1.25rem 1.5rem;">
      <div style="font-size:0.7rem;color:#6b8096;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.4rem;">対応中</div>
      <div style="font-size:1.75rem;font-weight:500;font-family:'JetBrains Mono',monospace;color:#ffb400;" id="kpi-inprog">—</div>
    </div>
    <div style="background:#080c10;padding:1.25rem 1.5rem;">
      <div style="font-size:0.7rem;color:#6b8096;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.4rem;">完了</div>
      <div style="font-size:1.75rem;font-weight:500;font-family:'JetBrains Mono',monospace;color:#00d464;" id="kpi-done">—</div>
    </div>
    <div style="background:#080c10;padding:1.25rem 1.5rem;">
      <div style="font-size:0.7rem;color:#6b8096;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.4rem;">合計</div>
      <div style="font-size:1.75rem;font-weight:500;font-family:'JetBrains Mono',monospace;color:#00d4ff;" id="kpi-total">—</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-title">
      <span>チケット一覧</span>
      <button class="btn-primary" onclick="toggleAddPanel()">+ 新規チケット</button>
    </div>

    <div class="add-panel" id="add-panel">
      <div class="form-grid">
        <div class="form-field"><label>件名 *</label><input id="f-title" placeholder="例：パソコンが起動しない（営業部 山田さん）" /></div>
        <div class="form-field">
          <label>カテゴリ</label>
          <select id="f-category">
            <option>PC</option><option>アプリ</option><option>インフラ</option><option>アカウント</option><option>その他</option>
          </select>
        </div>
        <div class="form-field">
          <label>優先度</label>
          <select id="f-priority"><option>高</option><option selected>中</option><option>低</option></select>
        </div>
        <div class="form-field">
          <label>担当者</label>
          <select id="f-assignee">
            <option value="未割当">未割当</option>
            <option>田中</option><option>山本</option><option>鈴木</option>
          </select>
        </div>
      </div>
      <div style="display:flex;gap:0.5rem;">
        <button class="btn-primary" onclick="addTicket()">追加する</button>
        <button class="btn" onclick="toggleAddPanel()">キャンセル</button>
      </div>
    </div>

    <div style="display:flex;gap:0;border-bottom:1px solid #1a2d3d;margin-bottom:1.25rem;overflow-x:auto;">
      <div class="tab active" id="tab-all" onclick="setFilter('all')">すべて <span id="count-all" style="font-family:'JetBrains Mono',monospace;font-size:0.65rem;color:#3d5266;"></span></div>
      <div class="tab" id="tab-open" onclick="setFilter('未対応')">未対応 <span id="count-open" style="font-family:'JetBrains Mono',monospace;font-size:0.65rem;color:#ff4444;"></span></div>
      <div class="tab" id="tab-inprog" onclick="setFilter('対応中')">対応中 <span id="count-inprog" style="font-family:'JetBrains Mono',monospace;font-size:0.65rem;color:#ffb400;"></span></div>
      <div class="tab" id="tab-done" onclick="setFilter('完了')">完了 <span id="count-done" style="font-family:'JetBrains Mono',monospace;font-size:0.65rem;color:#6b8096;"></span></div>
    </div>

    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>件名</th>
          <th>カテゴリ</th>
          <th>優先度</th>
          <th>担当</th>
          <th>ステータス <span style="color:#00d4ff;font-size:0.6rem;">（クリックで変更）</span></th>
          <th>作成</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="tickets-tbody"></tbody>
    </table>
    <div id="no-tickets" style="font-size:0.78rem;color:#3d5266;padding:1.5rem 0;display:none;text-align:center;">該当するチケットがありません</div>
  </div>

  <div class="demo-banner">
    <span style="font-size:0.75rem;color:#6b8096;">このページは荻野舜樹（ONSIGHT）によるデモです。入力データはブラウザにのみ保存されます。</span>
    <a href="/" style="font-size:0.75rem;color:#00d4ff;text-decoration:none;">← ポートフォリオに戻る</a>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
const KEY = 'onsight_hiroshima';
const ASSIGNEES = ['未割当','田中','山本','鈴木'];
const DEFAULT = {
  tickets: [
    { id: 1042, title: '社内VPNに接続できない（営業3課）', category: 'インフラ', priority: '高', status: '対応中', assignee: '田中', created: '05-27 09:15' },
    { id: 1041, title: '請求書発行システムで印刷できない', category: 'アプリ', priority: '高', status: '未対応', assignee: '未割当', created: '05-27 08:44' },
    { id: 1040, title: 'メール添付ファイルが開けない（特定PC）', category: 'PC', priority: '中', status: '対応中', assignee: '山本', created: '05-26 17:30' },
    { id: 1039, title: '新入社員アカウント作成依頼（3名）', category: 'アカウント', priority: '低', status: '完了', assignee: '田中', created: '05-26 14:00' },
    { id: 1038, title: 'Teamsの会議録音が保存されない', category: 'アプリ', priority: '中', status: '完了', assignee: '山本', created: '05-26 11:20' },
  ],
};

let state = (() => { try { return JSON.parse(localStorage.getItem(KEY)) || JSON.parse(JSON.stringify(DEFAULT)); } catch { return JSON.parse(JSON.stringify(DEFAULT)); } })();
let nextId = Math.max(...state.tickets.map(t => t.id), 0) + 1;
let filter = 'all';

function save() { localStorage.setItem(KEY, JSON.stringify(state)); }
function toast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2000);
}
function resetData() {
  if (!confirm('デモデータをリセットしますか？')) return;
  state = JSON.parse(JSON.stringify(DEFAULT)); nextId = 1043; filter = 'all';
  save(); render(); toast('リセットしました');
}

const STATUS_CYCLE = { '未対応': '対応中', '対応中': '完了', '完了': '未対応' };
const STATUS_CLASS = { '未対応': 'badge-open', '対応中': 'badge-inprog', '完了': 'badge-done' };
const PRIORITY_CLASS = { '高': 'badge-high', '中': 'badge-mid', '低': 'badge-low' };

function setFilter(f) {
  filter = f;
  ['all','open','inprog','done'].forEach(k => document.getElementById(`tab-${k}`).classList.remove('active'));
  document.getElementById(`tab-${f === 'all' ? 'all' : f === '未対応' ? 'open' : f === '対応中' ? 'inprog' : 'done'}`).classList.add('active');
  renderTickets();
}

function renderKPI() {
  const open = state.tickets.filter(t => t.status === '未対応').length;
  const inprog = state.tickets.filter(t => t.status === '対応中').length;
  const done = state.tickets.filter(t => t.status === '完了').length;
  document.getElementById('kpi-open').textContent = open;
  document.getElementById('kpi-inprog').textContent = inprog;
  document.getElementById('kpi-done').textContent = done;
  document.getElementById('kpi-total').textContent = state.tickets.length;
  document.getElementById('count-all').textContent = `(${state.tickets.length})`;
  document.getElementById('count-open').textContent = `(${open})`;
  document.getElementById('count-inprog').textContent = `(${inprog})`;
  document.getElementById('count-done').textContent = `(${done})`;
  const topOpen = document.getElementById('topbar-open');
  if (open > 0) { topOpen.textContent = `未対応 ${open}件`; topOpen.style.display = 'inline-block'; }
  else { topOpen.style.display = 'none'; }
}

function renderTickets() {
  let tickets = state.tickets.filter(t => {
    if (filter === 'all') return true;
    return t.status === filter;
  });
  const tbody = document.getElementById('tickets-tbody');
  const noTickets = document.getElementById('no-tickets');
  if (tickets.length === 0) { tbody.innerHTML = ''; noTickets.style.display = 'block'; return; }
  noTickets.style.display = 'none';
  tbody.innerHTML = tickets.map(t => `<tr>
    <td style="font-family:'JetBrains Mono',monospace;font-size:0.72rem;color:#00d4ff;">#${t.id}</td>
    <td style="max-width:280px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${t.title}</td>
    <td style="font-size:0.75rem;color:#6b8096;">${t.category}</td>
    <td><span class="badge ${PRIORITY_CLASS[t.priority]}">${t.priority}</span></td>
    <td>
      <select class="assignee-select" onchange="changeAssignee(${t.id}, this.value)">
        ${ASSIGNEES.map(a => `<option value="${a}" ${a===t.assignee?'selected':''}>${a}</option>`).join('')}
      </select>
    </td>
    <td>
      <span class="badge ${STATUS_CLASS[t.status]}" onclick="cycleStatus(${t.id})" title="クリックでステータス変更">${t.status} →</span>
    </td>
    <td style="font-family:'JetBrains Mono',monospace;font-size:0.7rem;color:#3d5266;">${t.created}</td>
    <td><button class="btn btn-danger" onclick="deleteTicket(${t.id})" style="font-size:0.65rem;padding:0.2rem 0.5rem;">削除</button></td>
  </tr>`).join('');
}

function render() { renderKPI(); renderTickets(); }

function cycleStatus(id) {
  const t = state.tickets.find(t => t.id === id);
  const next = STATUS_CYCLE[t.status];
  t.status = next;
  save(); render();
  toast(`#${id} を「${next}」に変更しました`);
}

function changeAssignee(id, val) {
  state.tickets.find(t => t.id === id).assignee = val;
  save(); render();
  toast(`#${id} の担当を「${val}」に変更しました`);
}

function deleteTicket(id) {
  if (!confirm('このチケットを削除しますか？')) return;
  state.tickets = state.tickets.filter(t => t.id !== id);
  save(); render(); toast(`#${id} を削除しました`);
}

function toggleAddPanel() {
  const p = document.getElementById('add-panel');
  p.classList.toggle('open');
  if (p.classList.contains('open')) document.getElementById('f-title').focus();
}

function addTicket() {
  const title = document.getElementById('f-title').value.trim();
  if (!title) { toast('件名を入力してください'); return; }
  const now = new Date();
  const created = `${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')} ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;
  state.tickets.unshift({
    id: nextId++,
    title,
    category: document.getElementById('f-category').value,
    priority: document.getElementById('f-priority').value,
    status: '未対応',
    assignee: document.getElementById('f-assignee').value,
    created,
  });
  document.getElementById('f-title').value = '';
  save(); toggleAddPanel(); render();
  toast(`チケット #${nextId-1} を追加しました`);
}

render();
</script>
</Layout>
