---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="在庫・発注管理システム | 瀬戸内商事株式会社">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: #080c10; color: #e8edf2; font-family: 'Inter', system-ui, sans-serif; }
.sidebar { position: fixed; left: 0; top: 0; bottom: 0; width: 220px; background: #0a0e14; border-right: 1px solid #1a2d3d; padding: 1.5rem 0; z-index: 10; }
.nav-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.625rem 1.5rem; font-size: 0.8rem; color: #6b8096; cursor: pointer; transition: all 0.15s; user-select: none; }
.nav-item:hover { color: #e8edf2; background: rgba(0,212,255,0.03); }
.nav-item.active { color: #e8edf2; background: rgba(0,212,255,0.06); border-left: 2px solid #00d4ff; }
.nav-section { font-size: 0.65rem; color: #3d5266; letter-spacing: 0.1em; padding: 1rem 1.5rem 0.35rem; text-transform: uppercase; }
.main { margin-left: 220px; }
.topbar { height: 52px; border-bottom: 1px solid #1a2d3d; display: flex; align-items: center; justify-content: space-between; padding: 0 2rem; background: rgba(8,12,16,0.95); position: sticky; top: 0; z-index: 5; }
.badge { font-size: 0.65rem; padding: 0.2rem 0.6rem; font-family: 'JetBrains Mono', monospace; display: inline-block; }
.badge-ok { background: rgba(0,212,100,0.12); color: #00d464; border: 1px solid rgba(0,212,100,0.2); }
.badge-warn { background: rgba(255,180,0,0.12); color: #ffb400; border: 1px solid rgba(255,180,0,0.2); }
.badge-danger { background: rgba(255,60,60,0.12); color: #ff4444; border: 1px solid rgba(255,60,60,0.2); }
.badge-info { background: rgba(0,112,243,0.12); color: #3399ff; border: 1px solid rgba(0,112,243,0.2); }
.badge-done { background: rgba(100,100,100,0.1); color: #6b8096; border: 1px solid #1a2d3d; }
.section { scroll-margin-top: 52px; }
.panel { background: #080c10; padding: 1.5rem; border-bottom: 1px solid #1a2d3d; }
.panel-title { font-size: 0.75rem; color: #6b8096; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1.25rem; font-family: 'JetBrains Mono', monospace; display: flex; justify-content: space-between; align-items: center; }
table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
th { text-align: left; padding: 0.5rem 0.75rem; color: #3d5266; font-size: 0.7rem; letter-spacing: 0.05em; text-transform: uppercase; border-bottom: 1px solid #1a2d3d; font-weight: 400; }
td { padding: 0.7rem 0.75rem; border-bottom: 1px solid rgba(26,45,61,0.5); vertical-align: middle; }
tr:hover td { background: rgba(0,212,255,0.015); }
.editable { cursor: pointer; border-bottom: 1px dashed #3d5266; transition: all 0.15s; }
.editable:hover { border-color: #00d4ff; color: #00d4ff; }
.inline-input { background: #0f1923; border: 1px solid #00d4ff; color: #e8edf2; padding: 0.2rem 0.5rem; font-size: 0.82rem; font-family: 'JetBrains Mono', monospace; width: 80px; outline: none; }
.btn { background: transparent; border: 1px solid #1a2d3d; color: #6b8096; padding: 0.3rem 0.8rem; font-size: 0.75rem; cursor: pointer; font-family: inherit; transition: all 0.15s; }
.btn:hover { border-color: #00d4ff; color: #00d4ff; }
.btn-primary { background: #00d4ff; color: #080c10; border: none; padding: 0.4rem 1rem; font-size: 0.75rem; cursor: pointer; font-weight: 600; font-family: inherit; transition: background 0.15s; }
.btn-primary:hover { background: #33ddff; }
.btn-order { background: rgba(255,180,0,0.1); color: #ffb400; border: 1px solid rgba(255,180,0,0.25); padding: 0.2rem 0.6rem; font-size: 0.7rem; cursor: pointer; font-family: 'JetBrains Mono', monospace; transition: all 0.15s; }
.btn-order:hover { background: rgba(255,180,0,0.2); }
.btn-danger { color: #ff4444; border-color: rgba(255,60,60,0.2); }
.btn-danger:hover { border-color: #ff4444; background: rgba(255,60,60,0.08); }
.btn-status { font-size: 0.65rem; padding: 0.15rem 0.5rem; border: 1px solid #1a2d3d; background: transparent; color: #6b8096; cursor: pointer; font-family: 'JetBrains Mono', monospace; transition: all 0.15s; white-space: nowrap; }
.btn-status:hover { border-color: #00d4ff; color: #00d4ff; }
.search-input { background: #0f1923; border: 1px solid #1a2d3d; color: #e8edf2; padding: 0.5rem 1rem; font-size: 0.8rem; font-family: inherit; outline: none; width: 280px; }
.search-input:focus { border-color: #00d4ff; }
.filter-btn { background: transparent; border: 1px solid #1a2d3d; color: #6b8096; padding: 0.4rem 0.9rem; font-size: 0.75rem; cursor: pointer; font-family: inherit; transition: all 0.15s; }
.filter-btn:hover { color: #e8edf2; }
.filter-btn.active { border-color: #00d4ff; color: #00d4ff; background: rgba(0,212,255,0.06); }
.add-form { background: #0f1923; border: 1px solid #1a2d3d; padding: 1.25rem; margin-top: 1rem; display: none; }
.add-form.open { display: block; }
.add-form-grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem; }
.form-field label { font-size: 0.65rem; color: #6b8096; font-family: 'JetBrains Mono', monospace; display: block; margin-bottom: 0.35rem; letter-spacing: 0.05em; }
.form-field input { width: 100%; background: #080c10; border: 1px solid #1a2d3d; color: #e8edf2; padding: 0.5rem 0.75rem; font-size: 0.8rem; font-family: inherit; outline: none; }
.form-field input:focus { border-color: #00d4ff; }
.order-input-row { display: flex; align-items: center; gap: 0.5rem; background: #0f1923; border: 1px solid #ffb400; padding: 0.5rem 0.75rem; margin-top: 0.4rem; }
.demo-banner { background: rgba(0,112,243,0.08); border-top: 1px solid rgba(0,112,243,0.2); padding: 0.75rem 2rem; display: flex; justify-content: space-between; align-items: center; }
.toast { position: fixed; bottom: 1.5rem; right: 1.5rem; background: #0f1923; border: 1px solid #00d4ff; color: #e8edf2; padding: 0.75rem 1.25rem; font-size: 0.8rem; z-index: 100; opacity: 0; transition: opacity 0.2s; pointer-events: none; font-family: 'JetBrains Mono', monospace; }
.toast.show { opacity: 1; }
</style>

<div class="sidebar">
  <div style="padding:1.25rem 1.5rem;border-bottom:1px solid #1a2d3d;">
    <div style="font-size:0.85rem;font-weight:600;">瀬戸内商事株式会社</div>
    <div style="font-size:0.7rem;color:#6b8096;margin-top:0.15rem;font-family:'JetBrains Mono',monospace;">在庫管理システム</div>
  </div>
  <div style="margin-top:1rem;">
    <div class="nav-section">在庫</div>
    <div class="nav-item active" id="nav-stock" onclick="scrollToSection('sec-stock','nav-stock')">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
      在庫一覧
    </div>
    <div class="nav-item" id="nav-orders" onclick="scrollToSection('sec-orders','nav-orders')">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
      発注管理
    </div>
  </div>
</div>

<div class="main">
  <div class="topbar">
    <div style="display:flex;align-items:center;gap:0.75rem;">
      <span style="font-family:'JetBrains Mono',monospace;font-size:0.75rem;color:#6b8096;">在庫一覧</span>
      <span class="badge badge-danger" id="topbar-alert" style="display:none;"></span>
    </div>
    <div style="display:flex;align-items:center;gap:0.75rem;">
      <span style="font-size:0.7rem;color:#3d5266;">データはブラウザに保存されます</span>
      <button class="btn" onclick="resetData()" style="font-size:0.65rem;">リセット</button>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#1a2d3d;">
    <div style="background:#080c10;padding:1.25rem 1.5rem;">
      <div style="font-size:0.7rem;color:#6b8096;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.4rem;">総品番数</div>
      <div style="font-size:1.75rem;font-weight:500;font-family:'JetBrains Mono',monospace;color:#00d4ff;" id="kpi-total">—</div>
    </div>
    <div style="background:#080c10;padding:1.25rem 1.5rem;">
      <div style="font-size:0.7rem;color:#6b8096;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.4rem;">在庫十分</div>
      <div style="font-size:1.75rem;font-weight:500;font-family:'JetBrains Mono',monospace;color:#00d464;" id="kpi-ok">—</div>
    </div>
    <div style="background:#080c10;padding:1.25rem 1.5rem;">
      <div style="font-size:0.7rem;color:#6b8096;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.4rem;">要発注</div>
      <div style="font-size:1.75rem;font-weight:500;font-family:'JetBrains Mono',monospace;color:#ffb400;" id="kpi-warn">—</div>
    </div>
    <div style="background:#080c10;padding:1.25rem 1.5rem;">
      <div style="font-size:0.7rem;color:#6b8096;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.4rem;">欠品危険</div>
      <div style="font-size:1.75rem;font-weight:500;font-family:'JetBrains Mono',monospace;color:#ff4444;" id="kpi-danger">—</div>
    </div>
  </div>

  <div id="sec-stock" class="section panel">
    <div class="panel-title">
      <span>在庫一覧</span>
      <button class="btn-primary" onclick="toggleAddForm()">+ 品番追加</button>
    </div>
    <div style="display:flex;gap:0.75rem;margin-bottom:1.25rem;flex-wrap:wrap;align-items:center;">
      <input class="search-input" type="text" placeholder="品番・品名で検索..." id="search-input" oninput="render()" />
      <button class="filter-btn active" id="filter-all" onclick="setFilter('all')">すべて</button>
      <button class="filter-btn" id="filter-warn" onclick="setFilter('要発注')">要発注</button>
      <button class="filter-btn" id="filter-danger" onclick="setFilter('欠品危険')">欠品危険</button>
    </div>
    <table>
      <thead>
        <tr>
          <th>品番</th>
          <th>品名</th>
          <th>現在庫 <span style="color:#00d4ff;font-size:0.6rem;">（クリックで編集）</span></th>
          <th>発注点</th>
          <th>仕入先</th>
          <th>ステータス</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="items-tbody"></tbody>
    </table>
    <div class="add-form" id="add-form">
      <div class="add-form-grid">
        <div class="form-field"><label>品番 *</label><input id="f-code" placeholder="ST-0000" /></div>
        <div class="form-field"><label>品名 *</label><input id="f-name" placeholder="品名を入力" /></div>
        <div class="form-field"><label>単位</label><input id="f-unit" placeholder="個" /></div>
        <div class="form-field"><label>現在庫 *</label><input id="f-stock" type="number" placeholder="100" min="0" /></div>
        <div class="form-field"><label>発注点 *</label><input id="f-reorder" type="number" placeholder="20" min="0" /></div>
      </div>
      <div class="form-field" style="margin-bottom:0.75rem;"><label>仕入先</label><input id="f-supplier" placeholder="株式会社○○" /></div>
      <div style="display:flex;gap:0.5rem;">
        <button class="btn-primary" onclick="addItem()">追加</button>
        <button class="btn" onclick="toggleAddForm()">キャンセル</button>
      </div>
    </div>
  </div>

  <div id="sec-orders" class="section panel">
    <div class="panel-title">
      <span>発注履歴</span>
      <span style="font-size:0.7rem;color:#3d5266;font-weight:400;letter-spacing:0;">ステータスをクリックで進捗更新・入荷完了で在庫に反映</span>
    </div>
    <table>
      <thead>
        <tr><th>日時</th><th>品番</th><th>品名</th><th>発注数</th><th>仕入先</th><th>状態 <span style="color:#00d4ff;font-size:0.6rem;">（クリックで更新）</span></th></tr>
      </thead>
      <tbody id="orders-tbody"></tbody>
    </table>
    <div id="no-orders" style="font-size:0.78rem;color:#3d5266;padding:1rem 0;">発注履歴なし — 在庫一覧から「発注する」を押してください</div>
  </div>

  <div class="demo-banner">
    <span style="font-size:0.75rem;color:#6b8096;">このページは荻野舜樹（ONSIGHT）によるデモです。入力データはブラウザにのみ保存されます。</span>
    <a href="/" style="font-size:0.75rem;color:#00d4ff;text-decoration:none;">← ポートフォリオに戻る</a>
  </div>
</div>

<div class="toast" id="toast"></div>

<!-- 発注数入力モーダル -->
<div id="order-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:200;align-items:center;justify-content:center;">
  <div style="background:#0f1923;border:1px solid #ffb400;padding:1.5rem;width:360px;max-width:90vw;">
    <div style="font-size:0.75rem;color:#6b8096;letter-spacing:0.08em;text-transform:uppercase;font-family:'JetBrains Mono',monospace;margin-bottom:1rem;">発注数量を入力</div>
    <div style="font-size:0.85rem;color:#e8edf2;margin-bottom:1rem;" id="modal-item-name">—</div>
    <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem;">
      <input type="number" id="modal-qty" min="1" style="flex:1;background:#080c10;border:1px solid #1a2d3d;color:#e8edf2;padding:0.5rem 0.75rem;font-size:1rem;font-family:'JetBrains Mono',monospace;outline:none;" onfocus="this.style.borderColor='#ffb400'" onblur="this.style.borderColor='#1a2d3d'" />
      <span id="modal-unit" style="font-size:0.8rem;color:#6b8096;"></span>
    </div>
    <div style="display:flex;gap:0.5rem;">
      <button class="btn-order" onclick="confirmOrder()" style="flex:1;padding:0.5rem;">発注する</button>
      <button class="btn" onclick="closeOrderModal()" style="padding:0.5rem 1rem;">キャンセル</button>
    </div>
  </div>
</div>

<script is:inline>
const KEY = 'onsight_setouchi';
const DEFAULT = {
  items: [
    { id: 1, code: 'ST-4411', name: 'ステンレス鋼板 2.0t', stock: 124, unit: '枚', reorder: 50, supplier: '中国鉄鋼㈱' },
    { id: 2, code: 'ST-2201', name: 'アルミ押出材 A6063', stock: 38, unit: 'kg', reorder: 40, supplier: '西日本アルミ㈱' },
    { id: 3, code: 'BT-0012', name: '六角ボルト M8×25', stock: 4200, unit: '本', reorder: 1000, supplier: '広島ファスナー㈱' },
    { id: 4, code: 'PL-3302', name: 'ポリカ板 5mm', stock: 12, unit: '枚', reorder: 20, supplier: '瀬戸内樹脂㈱' },
    { id: 5, code: 'AL-7700', name: 'アルミ板 t3.0', stock: 5, unit: '枚', reorder: 15, supplier: '西日本アルミ㈱' },
  ],
  orders: [],
};

let state = (() => { try { return JSON.parse(localStorage.getItem(KEY)) || JSON.parse(JSON.stringify(DEFAULT)); } catch { return JSON.parse(JSON.stringify(DEFAULT)); } })();
let nextId = Math.max(...state.items.map(i => i.id), 0) + 1;
let filter = 'all';
let orderingItemId = null;

function save() { localStorage.setItem(KEY, JSON.stringify(state)); }
function toast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2200);
}
function resetData() {
  if (!confirm('デモデータをリセットしますか？')) return;
  state = JSON.parse(JSON.stringify(DEFAULT)); nextId = 6; filter = 'all'; orderingItemId = null;
  save(); render(); toast('リセットしました');
}

function scrollToSection(sectionId, navId) {
  document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
  document.getElementById(navId).classList.add('active');
  document.getElementById(sectionId).scrollIntoView({ behavior: 'smooth' });
}

function getStatus(item) {
  if (item.stock === 0) return '欠品危険';
  if (item.stock < item.reorder) return '要発注';
  return '十分';
}

function statusBadge(s) {
  const map = { '十分': 'badge-ok', '要発注': 'badge-warn', '欠品危険': 'badge-danger' };
  return `<span class="badge ${map[s]}">${s}</span>`;
}

function setFilter(f) {
  filter = f;
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  document.getElementById(f === 'all' ? 'filter-all' : f === '要発注' ? 'filter-warn' : 'filter-danger').classList.add('active');
  render();
}

function renderKPI() {
  const items = state.items;
  const statuses = items.map(getStatus);
  document.getElementById('kpi-total').textContent = items.length;
  document.getElementById('kpi-ok').textContent = statuses.filter(s => s === '十分').length;
  document.getElementById('kpi-warn').textContent = statuses.filter(s => s === '要発注').length;
  document.getElementById('kpi-danger').textContent = statuses.filter(s => s === '欠品危険').length;
  const danger = statuses.filter(s => s !== '十分').length;
  const ta = document.getElementById('topbar-alert');
  if (danger > 0) { ta.textContent = `要対応 ${danger}件`; ta.style.display = 'inline-block'; }
  else { ta.style.display = 'none'; }
}

function renderItems() {
  const q = document.getElementById('search-input').value.toLowerCase();
  let items = state.items.filter(i => {
    if (q && !i.code.toLowerCase().includes(q) && !i.name.toLowerCase().includes(q)) return false;
    const s = getStatus(i);
    if (filter !== 'all' && s !== filter) return false;
    return true;
  });
  const tbody = document.getElementById('items-tbody');
  tbody.innerHTML = items.map(item => {
    const s = getStatus(item);
    return `<tr>
      <td style="font-family:'JetBrains Mono',monospace;font-size:0.78rem;color:#00d4ff;">${item.code}</td>
      <td>${item.name}</td>
      <td>
        <span class="editable" onclick="startEditStock(${item.id}, this)">${item.stock.toLocaleString()}</span>
        <span style="font-size:0.7rem;color:#3d5266;margin-left:0.25rem;">${item.unit}</span>
      </td>
      <td style="color:#6b8096;font-family:'JetBrains Mono',monospace;">${item.reorder.toLocaleString()}</td>
      <td style="color:#6b8096;font-size:0.78rem;">${item.supplier || '—'}</td>
      <td>${statusBadge(s)}</td>
      <td style="display:flex;gap:0.4rem;flex-wrap:wrap;">
        <button class="btn-order" onclick="openOrderModal(${item.id})">発注する</button>
        <button class="btn btn-danger" onclick="deleteItem(${item.id})" style="font-size:0.65rem;padding:0.2rem 0.5rem;">削除</button>
      </td>
    </tr>`;
  }).join('') || `<tr><td colspan="7" style="text-align:center;color:#3d5266;padding:1.5rem;">該当する品番がありません</td></tr>`;
}

const ORDER_STATUS_CYCLE = { '発注済': '入荷確認中', '入荷確認中': '入荷完了' };
const ORDER_STATUS_CLASS = { '発注済': 'badge-info', '入荷確認中': 'badge-warn', '入荷完了': 'badge-done' };

function renderOrders() {
  const orders = state.orders;
  const tbody = document.getElementById('orders-tbody');
  const noOrders = document.getElementById('no-orders');
  if (orders.length === 0) { tbody.innerHTML = ''; noOrders.style.display = 'block'; return; }
  noOrders.style.display = 'none';
  tbody.innerHTML = orders.slice(0,15).map(o => {
    const cls = ORDER_STATUS_CLASS[o.status] || 'badge-info';
    const next = ORDER_STATUS_CYCLE[o.status];
    const statusCell = next
      ? `<button class="btn-status" onclick="advanceOrderStatus(${o.id})"><span class="badge ${cls}" style="cursor:pointer;">${o.status}</span> → ${next}</button>`
      : `<span class="badge ${cls}">${o.status}</span>`;
    return `<tr>
      <td style="font-family:'JetBrains Mono',monospace;font-size:0.72rem;color:#6b8096;">${o.date}</td>
      <td style="font-family:'JetBrains Mono',monospace;font-size:0.78rem;color:#00d4ff;">${o.code}</td>
      <td style="font-size:0.78rem;">${o.name}</td>
      <td style="font-family:'JetBrains Mono',monospace;">${o.qty.toLocaleString()} ${o.unit}</td>
      <td style="color:#6b8096;font-size:0.78rem;">${o.supplier || '—'}</td>
      <td>${statusCell}</td>
    </tr>`;
  }).join('');
}

function render() { renderKPI(); renderItems(); renderOrders(); }

function startEditStock(id, el) {
  const item = state.items.find(i => i.id === id);
  const input = document.createElement('input');
  input.type = 'number'; input.className = 'inline-input';
  input.value = item.stock; input.min = 0;
  el.replaceWith(input); input.focus(); input.select();
  const commit = () => {
    const v = Math.max(0, parseInt(input.value) || 0);
    item.stock = v; save(); render();
    toast(`${item.name} の在庫を ${v} ${item.unit} に更新しました`);
  };
  input.addEventListener('blur', commit);
  input.addEventListener('keydown', e => { if (e.key === 'Enter') input.blur(); if (e.key === 'Escape') render(); });
}

function openOrderModal(id) {
  const item = state.items.find(i => i.id === id);
  orderingItemId = id;
  document.getElementById('modal-item-name').textContent = `${item.code}  ${item.name}`;
  document.getElementById('modal-unit').textContent = item.unit;
  document.getElementById('modal-qty').value = item.reorder * 2;
  document.getElementById('order-modal').style.display = 'flex';
  setTimeout(() => document.getElementById('modal-qty').select(), 50);
}

function closeOrderModal() {
  document.getElementById('order-modal').style.display = 'none';
  orderingItemId = null;
}

function confirmOrder() {
  const item = state.items.find(i => i.id === orderingItemId);
  const qty = parseInt(document.getElementById('modal-qty').value) || 0;
  if (qty <= 0) { toast('発注数を入力してください'); return; }
  const now = new Date();
  const date = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')} ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;
  state.orders.unshift({ id: Date.now(), date, code: item.code, name: item.name, qty, unit: item.unit, supplier: item.supplier, status: '発注済', itemId: item.id });
  closeOrderModal();
  save(); render();
  toast(`${item.name} を ${qty} ${item.unit} 発注しました`);
}

function advanceOrderStatus(orderId) {
  const order = state.orders.find(o => o.id === orderId);
  if (!order) return;
  const next = ORDER_STATUS_CYCLE[order.status];
  if (!next) return;
  order.status = next;
  if (next === '入荷完了') {
    const item = state.items.find(i => i.id === order.itemId);
    if (item) {
      item.stock += order.qty;
      toast(`入荷完了 — ${item.name} の在庫が ${item.stock} ${item.unit} になりました`);
    } else {
      toast('入荷完了として記録しました');
    }
  } else {
    toast(`発注 #${orderId} を「${next}」に更新しました`);
  }
  save(); render();
}

function deleteItem(id) {
  if (!confirm('この品番を削除しますか？')) return;
  state.items = state.items.filter(i => i.id !== id);
  save(); render(); toast('品番を削除しました');
}

function toggleAddForm() {
  const f = document.getElementById('add-form');
  f.classList.toggle('open');
  if (f.classList.contains('open')) document.getElementById('f-code').focus();
}

function addItem() {
  const code = document.getElementById('f-code').value.trim();
  const name = document.getElementById('f-name').value.trim();
  const stock = parseInt(document.getElementById('f-stock').value) || 0;
  const reorder = parseInt(document.getElementById('f-reorder').value) || 0;
  const unit = document.getElementById('f-unit').value.trim() || '個';
  const supplier = document.getElementById('f-supplier').value.trim();
  if (!code || !name) { toast('品番と品名は必須です'); return; }
  state.items.push({ id: nextId++, code, name, stock, unit, reorder, supplier });
  ['f-code','f-name','f-unit','f-stock','f-reorder','f-supplier'].forEach(id => document.getElementById(id).value = '');
  save(); toggleAddForm(); render();
  toast(`${name} を追加しました`);
}

document.getElementById('order-modal').addEventListener('click', e => {
  if (e.target === document.getElementById('order-modal')) closeOrderModal();
});

render();

window.scrollToSection = scrollToSection;
window.resetData = resetData;
window.setFilter = setFilter;
window.toggleAddForm = toggleAddForm;
window.addItem = addItem;
window.startEditStock = startEditStock;
window.openOrderModal = openOrderModal;
window.closeOrderModal = closeOrderModal;
window.confirmOrder = confirmOrder;
window.advanceOrderStatus = advanceOrderStatus;
window.deleteItem = deleteItem;
</script>
</Layout>
