---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="生産管理ダッシュボード | 山陽鉄工株式会社">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: #080c10; color: #e8edf2; font-family: 'Inter', system-ui, sans-serif; }
.sidebar { position: fixed; left: 0; top: 0; bottom: 0; width: 220px; background: #0a0e14; border-right: 1px solid #1a2d3d; padding: 1.5rem 0; z-index: 10; }
.nav-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.625rem 1.5rem; font-size: 0.8rem; color: #6b8096; cursor: pointer; transition: all 0.15s; user-select: none; }
.nav-item:hover { color: #e8edf2; background: rgba(0,212,255,0.03); }
.nav-item.active { color: #e8edf2; background: rgba(0,212,255,0.06); border-left: 2px solid #00d4ff; }
.nav-section { font-size: 0.65rem; color: #3d5266; letter-spacing: 0.1em; padding: 1rem 1.5rem 0.35rem; text-transform: uppercase; }
.main { margin-left: 220px; }
.topbar { height: 52px; border-bottom: 1px solid #1a2d3d; display: flex; align-items: center; justify-content: space-between; padding: 0 2rem; background: rgba(8,12,16,0.95); position: sticky; top: 0; z-index: 5; }
.badge { font-size: 0.65rem; padding: 0.2rem 0.6rem; font-family: 'JetBrains Mono', monospace; display: inline-block; }
.badge-ok { background: rgba(0,212,100,0.12); color: #00d464; border: 1px solid rgba(0,212,100,0.2); }
.badge-warn { background: rgba(255,180,0,0.12); color: #ffb400; border: 1px solid rgba(255,180,0,0.2); }
.badge-stop { background: rgba(255,60,60,0.12); color: #ff4444; border: 1px solid rgba(255,60,60,0.2); }
.badge-resolved { background: rgba(100,100,100,0.1); color: #3d5266; border: 1px solid #1a2d3d; }
.kpi-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; background: #1a2d3d; }
.kpi-card { background: #080c10; padding: 1.5rem; }
.kpi-label { font-size: 0.7rem; color: #6b8096; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 0.5rem; }
.kpi-value { font-size: 2rem; font-weight: 500; font-family: 'JetBrains Mono', monospace; color: #00d4ff; }
.kpi-sub { font-size: 0.7rem; color: #3d5266; margin-top: 0.25rem; }
.section { scroll-margin-top: 52px; }
.panel { background: #080c10; padding: 1.5rem; border-bottom: 1px solid #1a2d3d; }
.panel-title { font-size: 0.75rem; color: #6b8096; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1.25rem; font-family: 'JetBrains Mono', monospace; display: flex; justify-content: space-between; align-items: center; }
table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
th { text-align: left; padding: 0.5rem 0.75rem; color: #3d5266; font-size: 0.7rem; letter-spacing: 0.05em; text-transform: uppercase; border-bottom: 1px solid #1a2d3d; font-weight: 400; }
td { padding: 0.7rem 0.75rem; border-bottom: 1px solid rgba(26,45,61,0.5); vertical-align: middle; }
tr:hover td { background: rgba(0,212,255,0.015); }
.editable { cursor: pointer; border-bottom: 1px dashed #3d5266; transition: border-color 0.15s; }
.editable:hover { border-color: #00d4ff; color: #00d4ff; }
.inline-input { background: #0f1923; border: 1px solid #00d4ff; color: #e8edf2; padding: 0.2rem 0.5rem; font-size: 0.82rem; font-family: 'JetBrains Mono', monospace; width: 80px; outline: none; }
.status-select { background: #0a0e14; border: 1px solid #1a2d3d; color: #e8edf2; font-size: 0.7rem; padding: 0.2rem 0.4rem; font-family: 'JetBrains Mono', monospace; cursor: pointer; outline: none; }
.bar-container { width: 80px; height: 4px; background: #1a2d3d; display: inline-block; vertical-align: middle; }
.bar-fill { height: 100%; transition: width 0.4s ease; }
.btn { background: transparent; border: 1px solid #1a2d3d; color: #6b8096; padding: 0.3rem 0.8rem; font-size: 0.75rem; cursor: pointer; font-family: inherit; transition: all 0.15s; }
.btn:hover { border-color: #00d4ff; color: #00d4ff; }
.btn-primary { background: #00d4ff; color: #080c10; border: none; padding: 0.4rem 1rem; font-size: 0.75rem; cursor: pointer; font-weight: 600; font-family: inherit; transition: background 0.15s; }
.btn-primary:hover { background: #33ddff; }
.btn-danger { color: #ff4444; border-color: rgba(255,60,60,0.2); }
.btn-danger:hover { border-color: #ff4444; background: rgba(255,60,60,0.08); }
.btn-resolve { color: #00d464; border-color: rgba(0,212,100,0.2); font-size: 0.65rem; padding: 0.15rem 0.5rem; }
.btn-resolve:hover { border-color: #00d464; background: rgba(0,212,100,0.08); }
.add-form { background: #0f1923; border: 1px solid #1a2d3d; padding: 1.25rem; margin-top: 1rem; display: none; grid-template-columns: 1fr 1fr 1fr 1fr auto; gap: 0.75rem; align-items: end; }
.add-form.open { display: grid; }
.form-field label { font-size: 0.65rem; color: #6b8096; font-family: 'JetBrains Mono', monospace; display: block; margin-bottom: 0.35rem; letter-spacing: 0.05em; }
.form-field input, .form-field select { width: 100%; background: #080c10; border: 1px solid #1a2d3d; color: #e8edf2; padding: 0.5rem 0.75rem; font-size: 0.8rem; font-family: inherit; outline: none; }
.form-field input:focus, .form-field select:focus { border-color: #00d4ff; }
.alert-item { display: flex; gap: 0.75rem; align-items: flex-start; padding: 0.75rem 0; border-bottom: 1px solid rgba(26,45,61,0.5); }
.alert-time { font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; color: #3d5266; min-width: 40px; }
.demo-banner { background: rgba(0,112,243,0.08); border-top: 1px solid rgba(0,112,243,0.2); padding: 0.75rem 2rem; display: flex; justify-content: space-between; align-items: center; }
.toast { position: fixed; bottom: 1.5rem; right: 1.5rem; background: #0f1923; border: 1px solid #00d4ff; color: #e8edf2; padding: 0.75rem 1.25rem; font-size: 0.8rem; z-index: 100; opacity: 0; transition: opacity 0.2s; pointer-events: none; font-family: 'JetBrains Mono', monospace; }
.toast.show { opacity: 1; }
.chart-bar { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; flex: 1; cursor: default; position: relative; }
.chart-bar:hover .chart-tooltip { opacity: 1; }
.chart-tooltip { position: absolute; bottom: calc(100% + 4px); left: 50%; transform: translateX(-50%); background: #0f1923; border: 1px solid #1a2d3d; color: #e8edf2; font-size: 0.65rem; padding: 0.2rem 0.4rem; white-space: nowrap; font-family: 'JetBrains Mono', monospace; opacity: 0; transition: opacity 0.15s; pointer-events: none; z-index: 10; }
</style>

<div class="sidebar">
  <div style="padding:1.25rem 1.5rem;border-bottom:1px solid #1a2d3d;">
    <div style="font-size:0.85rem;font-weight:600;">山陽鉄工株式会社</div>
    <div style="font-size:0.7rem;color:#6b8096;margin-top:0.15rem;font-family:'JetBrains Mono',monospace;">生産管理システム</div>
  </div>
  <div style="margin-top:1rem;">
    <div class="nav-section">メイン</div>
    <div class="nav-item active" id="nav-dashboard" onclick="scrollToSection('sec-kpi','nav-dashboard')">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      ダッシュボード
    </div>
    <div class="nav-item" id="nav-lines" onclick="scrollToSection('sec-lines','nav-lines')">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      生産実績
    </div>
    <div class="nav-item" id="nav-alerts" onclick="scrollToSection('sec-charts','nav-alerts')">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      アラートログ
    </div>
    <div class="nav-section">設定</div>
    <div class="nav-item" id="nav-settings" onclick="scrollToSection('sec-lines','nav-settings')">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83"/></svg>
      ライン設定
    </div>
  </div>
</div>

<div class="main">
  <div class="topbar">
    <div style="display:flex;align-items:center;gap:0.75rem;">
      <span style="font-family:'JetBrains Mono',monospace;font-size:0.75rem;color:#6b8096;" id="today-date"></span>
      <span class="badge badge-ok" id="overall-status">正常稼働</span>
    </div>
    <div style="display:flex;align-items:center;gap:0.75rem;">
      <span style="font-size:0.7rem;color:#3d5266;">データはブラウザに保存されます</span>
      <button class="btn" onclick="resetData()" style="font-size:0.65rem;">リセット</button>
    </div>
  </div>

  <div id="sec-kpi" class="section kpi-grid">
    <div class="kpi-card">
      <div class="kpi-label">本日の総生産数</div>
      <div class="kpi-value" id="kpi-total">—</div>
      <div class="kpi-sub" id="kpi-target-text">目標合計 —</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">稼働ライン数</div>
      <div class="kpi-value" id="kpi-active">—</div>
      <div class="kpi-sub" id="kpi-line-total">全 — ライン</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">未解決アラート</div>
      <div class="kpi-value" id="kpi-alerts" style="color:#ffb400;">—</div>
      <div class="kpi-sub">警告・要対応のみ</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">全体達成率</div>
      <div class="kpi-value" id="kpi-rate">—</div>
      <div class="kpi-sub">本日現在</div>
    </div>
  </div>

  <div id="sec-lines" class="section panel">
    <div class="panel-title">
      <span>ライン別稼働状況</span>
      <button class="btn-primary" onclick="toggleAddLine()">+ ライン追加</button>
    </div>
    <table>
      <thead>
        <tr>
          <th>ライン名</th>
          <th>品番・品目</th>
          <th>目標数 <span style="color:#00d4ff;font-size:0.6rem;">（クリックで編集）</span></th>
          <th>実績数 <span style="color:#00d4ff;font-size:0.6rem;">（クリックで編集）</span></th>
          <th>達成率</th>
          <th>ステータス</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="lines-tbody"></tbody>
    </table>
    <div class="add-form" id="add-line-form">
      <div class="form-field">
        <label>ライン名</label>
        <input type="text" id="new-line-name" placeholder="LINE-E" />
      </div>
      <div class="form-field">
        <label>品番・品目</label>
        <input type="text" id="new-line-product" placeholder="SY-0000" />
      </div>
      <div class="form-field">
        <label>目標数</label>
        <input type="number" id="new-line-target" placeholder="200" min="0" />
      </div>
      <div class="form-field">
        <label>ステータス</label>
        <select id="new-line-status">
          <option value="稼働中">稼働中</option>
          <option value="調整中">調整中</option>
          <option value="停止中">停止中</option>
        </select>
      </div>
      <div style="display:flex;gap:0.5rem;">
        <button class="btn-primary" onclick="addLine()">追加</button>
        <button class="btn" onclick="toggleAddLine()">キャンセル</button>
      </div>
    </div>
  </div>

  <div id="sec-charts" class="section" style="display:grid;grid-template-columns:2fr 1fr;gap:1px;background:#1a2d3d;">
    <div class="panel">
      <div class="panel-title">
        <span>時間帯別生産推移（本日）</span>
      </div>
      <div style="display:flex;align-items:flex-end;gap:0.4rem;height:80px;" id="chart-bars"></div>
    </div>
    <div class="panel" style="border-left:1px solid #1a2d3d;">
      <div class="panel-title">
        <span>アラートログ</span>
        <button class="btn" onclick="toggleAddAlert()" style="font-size:0.65rem;">+ 追加</button>
      </div>
      <div id="add-alert-row" style="display:none;margin-bottom:0.75rem;">
        <input id="new-alert-msg" type="text" placeholder="アラート内容" style="width:100%;background:#0f1923;border:1px solid #1a2d3d;color:#e8edf2;padding:0.4rem 0.75rem;font-size:0.78rem;font-family:inherit;outline:none;margin-bottom:0.5rem;" onfocus="this.style.borderColor='#00d4ff'" onblur="this.style.borderColor='#1a2d3d'" />
        <div style="display:flex;gap:0.5rem;">
          <button class="btn-primary" onclick="addAlert()" style="font-size:0.7rem;">追加</button>
          <button class="btn" onclick="toggleAddAlert()" style="font-size:0.7rem;">キャンセル</button>
        </div>
      </div>
      <div id="alerts-list"></div>
    </div>
  </div>

  <div class="demo-banner">
    <span style="font-size:0.75rem;color:#6b8096;">このページは荻野舜樹（ONSIGHT）によるデモです。入力データはブラウザにのみ保存されます。</span>
    <a href="/" style="font-size:0.75rem;color:#00d4ff;text-decoration:none;">← ポートフォリオに戻る</a>
  </div>
</div>

<div class="toast" id="toast"></div>

<script is:inline>
const KEY = 'onsight_sanyo';
const DEFAULT = {
  lines: [
    { id: 1, name: 'LINE-A', product: 'SY-4400', target: 320, actual: 308, status: '稼働中' },
    { id: 2, name: 'LINE-B', product: 'SY-2210', target: 180, actual: 180, status: '稼働中' },
    { id: 3, name: 'LINE-C', product: 'SY-6600', target: 240, actual: 211, status: '調整中' },
    { id: 4, name: 'LINE-D', product: 'SY-1100', target: 150, actual: 0, status: '停止中' },
  ],
  alerts: [
    { id: 1, time: '09:14', msg: 'LINE-C 油圧センサー異常検知 — 保全班へ通知済み', level: 'warn' },
    { id: 2, time: '08:55', msg: 'LINE-D 計画メンテナンス開始', level: 'info' },
    { id: 3, time: '07:30', msg: 'LINE-A 生産開始確認', level: 'ok' },
  ],
};

let state = (() => { try { return JSON.parse(localStorage.getItem(KEY)) || JSON.parse(JSON.stringify(DEFAULT)); } catch { return JSON.parse(JSON.stringify(DEFAULT)); } })();
let nextLineId = Math.max(...state.lines.map(l => l.id), 0) + 1;
let nextAlertId = Math.max(...state.alerts.map(a => a.id), 0) + 1;

function save() { localStorage.setItem(KEY, JSON.stringify(state)); }

function toast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2200);
}

function resetData() {
  if (!confirm('デモデータをリセットしますか？')) return;
  state = JSON.parse(JSON.stringify(DEFAULT));
  nextLineId = 5; nextAlertId = 4;
  save(); render(); toast('リセットしました');
}

function scrollToSection(sectionId, navId) {
  document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
  document.getElementById(navId).classList.add('active');
  document.getElementById(sectionId).scrollIntoView({ behavior: 'smooth' });
}

function calcRate(t, a) { return t === 0 ? 0 : Math.round(a / t * 1000) / 10; }

function statusBadge(s) {
  const map = { '稼働中': 'badge-ok', '調整中': 'badge-warn', '停止中': 'badge-stop' };
  return `<span class="badge ${map[s] || 'badge-ok'}">${s}</span>`;
}

function renderKPI() {
  const active = state.lines.filter(l => l.status === '稼働中');
  const total = state.lines.reduce((s, l) => s + l.actual, 0);
  const target = state.lines.reduce((s, l) => s + l.target, 0);
  const rate = calcRate(target, total);
  const unresolvedAlerts = state.alerts.filter(a => a.level === 'warn').length;
  document.getElementById('kpi-total').textContent = total.toLocaleString();
  document.getElementById('kpi-target-text').textContent = `目標合計 ${target.toLocaleString()}`;
  document.getElementById('kpi-active').textContent = active.length;
  document.getElementById('kpi-line-total').textContent = `全 ${state.lines.length} ライン`;
  const alertEl = document.getElementById('kpi-alerts');
  alertEl.textContent = unresolvedAlerts;
  alertEl.style.color = unresolvedAlerts > 0 ? '#ffb400' : '#00d4ff';
  document.getElementById('kpi-rate').textContent = rate + '%';
  document.getElementById('kpi-rate').style.color = rate >= 90 ? '#00d464' : rate >= 70 ? '#ffb400' : '#ff4444';
  document.getElementById('overall-status').textContent = unresolvedAlerts > 0 ? '要確認' : '正常稼働';
  document.getElementById('overall-status').className = 'badge ' + (unresolvedAlerts > 0 ? 'badge-warn' : 'badge-ok');
}

function renderLines() {
  const tbody = document.getElementById('lines-tbody');
  tbody.innerHTML = state.lines.map(l => {
    const rate = calcRate(l.target, l.actual);
    const barColor = rate >= 90 ? '#00d464' : rate >= 70 ? '#ffb400' : '#ff4444';
    return `<tr>
      <td style="font-family:'JetBrains Mono',monospace;font-size:0.8rem;color:#00d4ff;">${l.name}</td>
      <td style="color:#6b8096;">${l.product}</td>
      <td>
        <span class="editable" onclick="startEdit('target',${l.id}, this)">${l.target}</span>
      </td>
      <td>
        <span class="editable" onclick="startEdit('actual',${l.id}, this)">${l.actual}</span>
      </td>
      <td>
        <div style="display:flex;align-items:center;gap:0.5rem;">
          <div class="bar-container"><div class="bar-fill" style="width:${Math.min(rate,100)}%;background:${barColor};"></div></div>
          <span style="font-size:0.75rem;font-family:'JetBrains Mono',monospace;">${rate}%</span>
        </div>
      </td>
      <td>
        <select class="status-select" onchange="changeStatus(${l.id}, this.value)">
          ${['稼働中','調整中','停止中'].map(s => `<option value="${s}" ${s===l.status?'selected':''}>${s}</option>`).join('')}
        </select>
      </td>
      <td><button class="btn btn-danger" onclick="deleteLine(${l.id})" style="font-size:0.65rem;padding:0.2rem 0.5rem;">削除</button></td>
    </tr>`;
  }).join('');
}

function renderAlerts() {
  const el = document.getElementById('alerts-list');
  const levelMap = {
    warn: ['badge-warn', '警告'],
    info: ['badge-ok', '情報'],
    ok: ['badge-ok', '正常'],
    resolved: ['badge-resolved', '解決済'],
  };
  el.innerHTML = state.alerts.slice(0, 8).map(a => {
    const [cls, label] = levelMap[a.level] || levelMap.info;
    const resolveBtn = (a.level === 'warn' || a.level === 'info')
      ? `<button class="btn btn-resolve" onclick="resolveAlert(${a.id})" style="margin-left:auto;flex-shrink:0;">解決済みにする</button>`
      : '';
    return `<div class="alert-item">
      <span class="alert-time">${a.time}</span>
      <div style="flex:1;min-width:0;">
        <span class="badge ${cls}" style="margin-bottom:0.25rem;display:inline-block;">${label}</span>
        <div style="font-size:0.78rem;color:#6b8096;margin-top:0.2rem;">${a.msg}</div>
      </div>
      ${resolveBtn}
    </div>`;
  }).join('') || '<div style="font-size:0.78rem;color:#3d5266;">アラートなし</div>';
}

function renderChart() {
  const target = state.lines.reduce((s,l)=>s+l.target, 1);
  const actual = state.lines.reduce((s,l)=>s+l.actual, 0);
  const hourlyBase = [8, 18, 32, 48, 62, 72, 80, 87, 91, 94, 96, actual > 0 ? Math.min(99, Math.round(actual/target*100)) : 88];
  const hours = ['07','08','09','10','11','12','13','14','15','16','17','現在'];
  document.getElementById('chart-bars').innerHTML = hourlyBase.map((v, i) => {
    const isNow = i === hourlyBase.length - 1;
    return `<div class="chart-bar" style="flex:1;">
      <div class="chart-tooltip">${v}%</div>
      <div style="height:${v * 0.6}px;background:${isNow ? '#00d4ff' : `rgba(0,212,255,${0.15+v/300})`};width:100%;transition:height 0.3s;"></div>
      <span style="font-size:0.58rem;color:${isNow?'#00d4ff':'#3d5266'};font-family:'JetBrains Mono',monospace;">${hours[i]}</span>
    </div>`;
  }).join('');
}

function render() { renderKPI(); renderLines(); renderAlerts(); renderChart(); }

function startEdit(field, id, el) {
  const line = state.lines.find(l => l.id === id);
  const input = document.createElement('input');
  input.type = 'number';
  input.className = 'inline-input';
  input.value = line[field];
  input.min = 0;
  el.replaceWith(input);
  input.focus();
  input.select();
  const commit = () => {
    const v = Math.max(0, parseInt(input.value) || 0);
    line[field] = v;
    save(); render();
    toast(`${line.name} ${field === 'actual' ? '実績' : '目標'}を ${v} に更新しました`);
  };
  input.addEventListener('blur', commit);
  input.addEventListener('keydown', e => { if (e.key === 'Enter') input.blur(); if (e.key === 'Escape') render(); });
}

function changeStatus(id, val) {
  state.lines.find(l => l.id === id).status = val;
  save(); render();
  toast(`ステータスを「${val}」に変更しました`);
}

function deleteLine(id) {
  if (!confirm('このラインを削除しますか？')) return;
  state.lines = state.lines.filter(l => l.id !== id);
  save(); render();
  toast('ラインを削除しました');
}

function toggleAddLine() {
  const f = document.getElementById('add-line-form');
  f.classList.toggle('open');
  if (f.classList.contains('open')) document.getElementById('new-line-name').focus();
}

function addLine() {
  const name = document.getElementById('new-line-name').value.trim();
  const product = document.getElementById('new-line-product').value.trim() || '—';
  const target = parseInt(document.getElementById('new-line-target').value) || 0;
  const status = document.getElementById('new-line-status').value;
  if (!name) { toast('ライン名を入力してください'); return; }
  state.lines.push({ id: nextLineId++, name, product, target, actual: 0, status });
  document.getElementById('new-line-name').value = '';
  document.getElementById('new-line-product').value = '';
  document.getElementById('new-line-target').value = '';
  save(); toggleAddLine(); render();
  toast(`${name} を追加しました`);
}

function toggleAddAlert() {
  const r = document.getElementById('add-alert-row');
  r.style.display = r.style.display === 'none' ? 'block' : 'none';
  if (r.style.display === 'block') document.getElementById('new-alert-msg').focus();
}

function addAlert() {
  const msg = document.getElementById('new-alert-msg').value.trim();
  if (!msg) { toast('内容を入力してください'); return; }
  const now = new Date();
  const time = `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;
  state.alerts.unshift({ id: nextAlertId++, time, msg, level: 'warn' });
  document.getElementById('new-alert-msg').value = '';
  save(); toggleAddAlert(); render();
  toast('アラートを追加しました');
}

function resolveAlert(id) {
  const alert = state.alerts.find(a => a.id === id);
  if (!alert) return;
  alert.level = 'resolved';
  save(); render();
  toast('アラートを解決済みにしました');
}

const now = new Date();
document.getElementById('today-date').textContent = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;
render();

window.scrollToSection = scrollToSection;
window.resetData = resetData;
window.toggleAddLine = toggleAddLine;
window.addLine = addLine;
window.startEdit = startEdit;
window.changeStatus = changeStatus;
window.deleteLine = deleteLine;
window.toggleAddAlert = toggleAddAlert;
window.addAlert = addAlert;
window.resolveAlert = resolveAlert;
</script>
</Layout>
