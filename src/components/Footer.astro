---
// 共通フッター。リンクURLの正は content_store.LINKS（→ src/data/links.json に書き出す）。
// ここは links.json を読むだけの“差込口”。URL変更は LINKS を直して export_links_json() を実行。
import links from '../data/links.json';
interface Props { lang?: 'ja' | 'en'; }
const { lang = 'ja' } = Astro.props;
const ft = lang === 'en'
  ? { discord: 'Discord — a lab for locally-running AI agents', run: 'This site and its social posts are, for the most part, operated by AI.',
      gate: 'Contact goes through one door: syuntan5151@gmail.com — DMs and LINE are not inboxes here (nothing picks them up; they get missed).',
      // 数字ページへの唯一の導線（2026-07-24）。トップには数字を出さない＝見に来た人だけが見る。
      stats: 'The numbers — how far these posts actually reach', statsHref: '/en/analysis' }
  : { discord: `Discord — ${links.discord.note}`, run: 'このサイトと各SNSでの発信は、基本的にAIが運用しています。',
      // 門宣言・フル版（2026-07-16荻野確定＝6/28「着信は門を1個宣言」の適用。コメント記録の言及は同日夜に荻野判断で削除）
      gate: '連絡はメール1本にしています：syuntan5151@gmail.com ／ DMやLINEは受信箱として使っていません（自動で拾う仕組みがなく、見落とします）。',
      stats: '発信の数字 — どれだけ届いたかの実測値', statsHref: '/analysis' };
const socials = [
  { name: 'GitHub', href: links.github.url },
  { name: 'Discord', href: links.discord.url },
  { name: 'YouTube', href: links.youtube.url },
  { name: 'Instagram', href: links.instagram.url },
];
---
<footer style="border-top:1px solid var(--border);padding:2.5rem 2rem;margin-top:5rem;position:relative;z-index:1;">
  <div style="max-width:1100px;margin:0 auto;">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;">
      <span style="font-family:'JetBrains Mono',monospace;font-size:0.72rem;color:var(--text3);letter-spacing:0.05em;">© 2026 荻野舜樹のAI実験室</span>
      <div style="display:flex;gap:1.5rem;align-items:center;">
        {socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.name}
            title={s.name === 'Discord' ? 'Discord — ローカルエージェントAIの実験室' : s.name}
            style="color:var(--text2);display:inline-flex;align-items:center;transition:color .15s;"
            onmouseover="this.style.color='var(--accent)'"
            onmouseout="this.style.color='var(--text2)'"
          >
            {s.name === 'GitHub' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.2 3.44 9.6 8.21 11.16.6.11.82-.25.82-.56v-2c-3.34.71-4.04-1.58-4.04-1.58-.55-1.37-1.34-1.74-1.34-1.74-1.09-.73.08-.72.08-.72 1.2.08 1.84 1.22 1.84 1.22 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.57-2.67-.3-5.47-1.31-5.47-5.84 0-1.29.47-2.34 1.24-3.17-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.21a11.5 11.5 0 0 1 3-.4c1.02 0 2.05.13 3 .4 2.29-1.53 3.3-1.21 3.3-1.21.66 1.66.25 2.88.12 3.18.77.83 1.24 1.88 1.24 3.17 0 4.54-2.81 5.54-5.49 5.83.43.37.81 1.1.81 2.22v3.29c0 .31.21.68.82.56A12.01 12.01 0 0 0 24 12.29C24 5.78 18.63.5 12 .5z" />
              </svg>
            )}
            {s.name === 'Discord' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.6 12.6 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.086-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.332-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.086-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.332-.946 2.418-2.157 2.418z" />
              </svg>
            )}
            {s.name === 'YouTube' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-2C18.88 4 12 4 12 4s-6.88 0-8.59.42a2.78 2.78 0 0 0-1.95 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.41 19c1.71.42 8.59.42 8.59.42s6.88 0 8.59-.42a2.78 2.78 0 0 0 1.95-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z" />
                <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" fill="currentColor" stroke="none" />
              </svg>
            )}
            {s.name === 'Instagram' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>

    <!-- Discord の位置づけ明記＋運用の注記（目立たない小さめ） -->
    <div style="margin-top:1.5rem;display:flex;flex-direction:column;gap:0.4rem;">
      <a href={links.discord.url} target="_blank" rel="noopener noreferrer" style="font-size:0.7rem;color:var(--text3);text-decoration:none;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text3)'">
        {ft.discord}
      </a>
      <a href={ft.statsHref} style="font-size:0.7rem;color:var(--text3);text-decoration:none;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text3)'">
        {ft.stats}
      </a>
      <p style="font-size:0.7rem;color:var(--text3);line-height:1.6;">
        {ft.run}
      </p>
      <p style="font-size:0.7rem;color:var(--text3);line-height:1.6;">
        {ft.gate}
      </p>
      <p style="font-size:0.6rem;color:var(--text3);line-height:1.6;opacity:0.7;margin-top:0.3rem;">
        This content uses sample data owned and copyrighted by Live2D Inc. The sample data are utilized in accordance with the terms and conditions set by Live2D Inc. This content itself is created at the author's sole discretion.
      </p>
    </div>
  </div>
</footer>
