---
// 共通トップナビ（唯一の正）。各ページはこれを置くだけ。リンク変更はここ1箇所。
interface Props {
  active?: 'thesis' | 'works' | 'blog' | '';
  maxWidth?: string;
}
const { active = '', maxWidth = '1100px' } = Astro.props;
const links = [
  { key: 'works', label: '作ったもの', href: '/#works' },
  { key: 'blog', label: 'ブログ', href: '/blog' },
];
---
<nav style="position:fixed;top:0;left:0;right:0;z-index:100;border-bottom:1px solid var(--border);backdrop-filter:blur(12px);background:rgba(8,12,16,0.85);">
  <div class="nav-inner" style={`max-width:${maxWidth};margin:0 auto;padding:0 2rem;display:flex;justify-content:space-between;align-items:center;height:56px;`}>
    <a href="/" style="font-family:'JetBrains Mono',monospace;font-size:0.85rem;color:var(--accent);letter-spacing:0.08em;text-decoration:none;">荻野舜樹</a>
    <div class="nav-actions" style="display:flex;gap:2rem;align-items:center;">
      {links.map((l) => (
        <a
          href={l.href}
          style={`font-size:0.8rem;color:${active === l.key ? 'var(--text)' : 'var(--text2)'};text-decoration:none;letter-spacing:0.05em;text-transform:uppercase;`}
          onmouseover="this.style.color='var(--text)'"
          onmouseout={`this.style.color='${active === l.key ? 'var(--text)' : 'var(--text2)'}'`}
        >{l.label}</a>
      ))}
      <a href="/#contact" style="font-size:0.8rem;color:var(--accent);text-decoration:none;letter-spacing:0.05em;border:1px solid var(--border);padding:0.3rem 0.8rem;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">連絡</a>
    </div>
  </div>
</nav>
<style>
  @media (max-width: 600px) {
    .nav-inner { padding: 0 1.25rem !important; }
    .nav-actions { gap: 1rem !important; }
    .nav-actions a { font-size: 0.72rem !important; letter-spacing: 0.02em !important; }
  }
  @media (max-width: 360px) {
    .nav-actions { gap: 0.7rem !important; }
    .nav-actions a { font-size: 0.66rem !important; }
  }
</style>
