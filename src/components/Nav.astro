---
// 共通トップナビ（唯一の正）。各ページはこれを置くだけ。リンク変更はここ1箇所。
interface Props {
  active?: 'thesis' | 'works' | 'blog' | '';
  maxWidth?: string;
  lang?: 'ja' | 'en';
}
const { active = '', maxWidth = '1100px', lang = 'ja' } = Astro.props;
const base = lang === 'en' ? '/en' : '';
const t = lang === 'en'
  ? { logo: "Shunki Ogino's AI Lab", works: 'What I make', blog: 'Writing', contact: 'Contact', other: '日本語', otherHref: '/' }
  : { logo: '荻野舜樹のAI実験室', works: '作ったもの', blog: '考えていること', contact: '連絡', other: 'EN', otherHref: '/en' };
const links = [
  { key: 'works', label: t.works, href: `${base}/#works` },
  { key: 'blog', label: t.blog, href: `${base}/blog` },
];
---
<nav style="position:fixed;top:0;left:0;right:0;z-index:100;border-bottom:1px solid var(--border);backdrop-filter:blur(12px);background:rgba(8,12,16,0.85);">
  <div class="nav-inner" style={`max-width:${maxWidth};margin:0 auto;padding:0 2rem;display:flex;justify-content:space-between;align-items:center;height:56px;`}>
    <a href={`${base}/`} class="nav-logo" style="font-family:'JetBrains Mono',monospace;font-size:0.85rem;color:var(--accent);letter-spacing:0.08em;text-decoration:none;">{t.logo}</a>
    <div class="nav-actions" style="display:flex;gap:2rem;align-items:center;">
      {links.map((l) => (
        <a
          href={l.href}
          style={`font-size:0.8rem;color:${active === l.key ? 'var(--text)' : 'var(--text2)'};text-decoration:none;letter-spacing:0.05em;text-transform:uppercase;`}
          onmouseover="this.style.color='var(--text)'"
          onmouseout={`this.style.color='${active === l.key ? 'var(--text)' : 'var(--text2)'}'`}
        >{l.label}</a>
      ))}
      <a href={t.otherHref} style="font-size:0.72rem;color:var(--text2);text-decoration:none;letter-spacing:0.05em;border:1px solid var(--border);padding:0.3rem 0.6rem;" onmouseover="this.style.color='var(--text)';this.style.borderColor='var(--text2)'" onmouseout="this.style.color='var(--text2)';this.style.borderColor='var(--border)'">{t.other}</a>
      <a href={`${base}/#contact`} style="font-size:0.8rem;color:var(--accent);text-decoration:none;letter-spacing:0.05em;border:1px solid var(--border);padding:0.3rem 0.8rem;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">{t.contact}</a>
    </div>
  </div>
</nav>
<style>
  /* スマホでも1行に収める：折り返し禁止＋ロゴだけ縮んで省略（メニューは常に全部見える） */
  .nav-logo, .nav-actions a { white-space: nowrap; }
  .nav-actions { flex-shrink: 0; }
  @media (max-width: 640px) {
    .nav-inner { padding: 0 0.9rem !important; gap: 0.5rem; }
    .nav-logo { font-size: 0.7rem !important; letter-spacing: 0.01em !important; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
    .nav-actions { gap: 0.5rem !important; }
    .nav-actions a { font-size: 0.68rem !important; letter-spacing: 0 !important; }
  }
  @media (max-width: 374px) {
    .nav-actions { gap: 0.45rem !important; }
    .nav-actions a { font-size: 0.64rem !important; }
  }
</style>
